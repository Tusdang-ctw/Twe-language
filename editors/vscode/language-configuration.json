{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" },
    { "open": "\"\"\"", "close": "\"\"\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(let|var|if|elif|else|while|for|function|entity|item|modifier|inventory|scene|particles|state|every|on)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(else|elif)\\b.*:\\s*(#.*)?$"
  }
}
