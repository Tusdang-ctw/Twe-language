# @task: a small 3rd-person action slice (Tunic-like)
# @inputs: WASD move, Shift run, Space / left-click attack
# @expected: a hero with blended locomotion + a sword attack, enemies,
#            and a physics rope bridge — the web3d-M11 reference game
# @category: 3d
# @difficulty: showcase
#
# web3d-M11: the reference game for "game-feature depth". It exercises
# animation crossfade (idle↔walk↔run, and a one-shot attack; web3d-M11
# session 1) and physics joints (a swinging rope bridge; session 2).
#
# Run:  twec play3d examples/action3d/main.twe
#       twec build --target web examples/action3d   (then serve dist/web)

let hero = "assets/hero.glb"

# Locomotion speeds (m/s). Shift runs.
let walk_speed = 3.2
let run_speed = 6.5

# Hero state (world XZ; y is the ground).
var hero_x = 0.0
var hero_z = 6.0
var hero_heading = 0.0       # yaw radians; 0 faces +Z (the model's front)
var speed_now = 0.0          # smoothed ground speed, drives the loco blend space
var attacking = 0.0          # seconds left in an attack (locks locomotion)

# Chase-camera state (smoothed).
var cam_x = 0.0
var cam_y = 4.0
var cam_z = 12.0

# ---------------------------------------------------------------
# Lighting + materials (procedural; web3d-M7).
# ---------------------------------------------------------------
light.clear()
light.environment("assets/sky.hdr", 0.55)   # image-based ambient + backdrop
sun.direction(vec3(-0.4, 0.85, 0.3))
sun.shadow(true)
sun.shadow_extent(20.0)
postfx.ao(0.9)
postfx.bloom(0.3)
postfx.taa(false)
auto_pause_on_blur(true)

visual GrassMat:
    surface(uv, time, pos) -> material:
        let blade = noise((pos.x, pos.z) * 1.3) * 0.5 + noise((pos.x, pos.z) * 5) * 0.25
        let path = 1 - smoothstep(1.5, 3.0, math.abs(pos.x))
        let green = mix((0.13, 0.28, 0.12), (0.18, 0.36, 0.15), blade)
        let dirt = (0.32, 0.26, 0.18)
        return material(albedo: mix(green, dirt, path * 0.7), roughness: 0.9)

entity Ground:
    var pos = vec3(0, -0.5, 0)
    look:
        mesh: "assets/grid_plane.glb"
        scale: 48.0
        material: GrassMat

spawn Ground

# ---------------------------------------------------------------
# The hero: its pos/facing track the globals the scene drives.
# ---------------------------------------------------------------
entity Hero:
    var pos = vec3(0, -0.5, 6)
    look:
        mesh: "assets/hero.glb"
        tint: (1.0, 1.0, 1.0)
        scale: 1.0
        facing: hero_heading

    function update(dt):
        pos = vec3(hero_x, -0.5, hero_z)

spawn Hero at vec3(0, -0.5, 6)

# True during the attack's mid-swing hit window; enemies in range read it.
var attack_hit = false
var kills = 0

# Ground-plane distance² to the hero.
function dist2_to_hero(x, z):
    let dx = x - hero_x
    let dz = z - hero_z
    return dx * dx + dz * dz

# ---------------------------------------------------------------
# Enemies: blobs that chase the hero; a sword swing in range kills them.
# ---------------------------------------------------------------
visual EnemyMat:
    surface(uv, time, pos) -> material:
        let pulse = 0.5 + 0.5 * math.sin(time * 4 + pos.x + pos.z)
        let mottle = noise((uv.x * 7, uv.y * 7)) * 0.12
        return material(albedo: (0.7 + mottle, 0.12, 0.14), roughness: 0.3, emission: (0.5, 0.04, 0.05) * pulse)

entity Enemy:
    var pos = vec3(0, 0, 0)
    var hp = 2
    var hurt = 0.0
    look:
        mesh: "sphere"
        tint: (1.0, 1.0, 1.0)
        scale: 0.8
        material: EnemyMat

    function update(dt):
        # Chase the hero on the ground plane.
        let dx = hero_x - pos.x
        let dz = hero_z - pos.z
        let mag = math.sqrt(dx * dx + dz * dz)
        if mag > 0.9:
            let s = 2.0 * dt / mag
            pos = vec3(pos.x + dx * s, 0.0, pos.z + dz * s)
        if hurt > 0.0:
            hurt = hurt - dt
        # Take a hit when the hero's swing connects in range.
        if attack_hit and dist2_to_hero(pos.x, pos.z) < 3.2 and hurt <= 0.0:
            hp = hp - 1
            hurt = 0.3
            if hp <= 0:
                kills = kills + 1
                despawn self

# A ring of enemies around the arena.
for i in 0..<8:
    let a = i / 8.0 * 6.2832
    spawn Enemy at vec3(math.sin(a) * 12.0, 0.0, math.cos(a) * 12.0)

# ---------------------------------------------------------------
# A swinging rope bridge: dynamic plank bodies linked by spherical
# joints (web3d-M11 session 2), anchored to two static posts. It sags
# into a catenary and sways when shoved (press E).
#
# web3d-M11 follow-on: rapier3d now compiles to wasm, so the bridge runs
# in the browser too — same physics world as native, no guard needed.
# ---------------------------------------------------------------
var plank_handles = []
let n = 9
let span = 11.0
let by = 3.4
let bz = -8.0
let seg = span / n
let edge = seg / 2
let left_post = physics.static_box(vec3(-span / 2 - 0.3, by, bz), vec3(0.3, 0.6, 1.4))
let right_post = physics.static_box(vec3(span / 2 + 0.3, by, bz), vec3(0.3, 0.6, 1.4))
var prev = left_post
for i in 0..<n:
    let px = -span / 2 + (i + 0.5) * seg
    let plank = physics.body("box", vec3(px, by, bz), 0.4)
    plank_handles.append(plank)
    physics.spherical_joint(prev, plank, vec3(edge, 0, 0), vec3(0 - edge, 0, 0))
    prev = plank
physics.spherical_joint(prev, right_post, vec3(edge, 0, 0), vec3(0 - edge, 0, 0))

# ---------------------------------------------------------------
# The game loop.
# ---------------------------------------------------------------
scene Action:
    initial: playing

    state playing:
        on update(dt):
            # --- Movement input (world XZ) ---
            var mx = 0.0
            var mz = 0.0
            if key.w or key.up:
                mz = mz - 1.0
            if key.s or key.down:
                mz = mz + 1.0
            if key.a or key.left:
                mx = mx - 1.0
            if key.d or key.right:
                mx = mx + 1.0
            let running = key_held("shift")
            let mag = math.sqrt(mx * mx + mz * mz)

            # Attack: one-shot, locks locomotion while it plays.
            if attacking <= 0.0 and (key_pressed("space") or mouse_press.left):
                attacking = 0.45
                mesh_anim.play(hero, "attack", false)
            if attacking > 0.0:
                attacking = attacking - dt
            # The swing connects mid-animation (0.12..0.3 s remaining).
            attack_hit = attacking > 0.12 and attacking < 0.3

            # --- Move + face ---
            var target_speed = 0.0
            if mag > 0.01 and attacking <= 0.0:
                let spd = if running: run_speed else: walk_speed
                hero_x = hero_x + mx / mag * spd * dt
                hero_z = hero_z + mz / mag * spd * dt
                hero_heading = math.atan2(mx, mz)
                target_speed = spd
            # Smooth the speed so the blend doesn't snap.
            speed_now = speed_now + (target_speed - speed_now) * math.min(1.0, dt * 10.0)

            # --- Locomotion: a 1-D blend space driven by ground speed ---
            # idle@0 → walk@walk_speed → run@run_speed, blended continuously
            # (no popping as the speed crosses a threshold). The attack clip
            # locks it out while a swing plays.
            if attacking <= 0.0:
                mesh_anim.blend_space(hero, ["idle", "walk", "run"], [0.0, walk_speed, run_speed], speed_now)
            mesh_anim.advance(dt)

            # --- Chase camera (smoothed, behind the heading) ---
            let dist = 7.0
            let want_x = hero_x - math.sin(hero_heading) * dist
            let want_z = hero_z - math.cos(hero_heading) * dist
            let k = math.min(1.0, dt * 5.0)
            cam_x = cam_x + (want_x - cam_x) * k
            cam_z = cam_z + (want_z - cam_z) * k
            cam_y = cam_y + (4.5 - cam_y) * k
            camera.eye = vec3(cam_x, cam_y, cam_z)
            camera.target = vec3(hero_x, 1.0, hero_z)

            # Shove the bridge (native and browser alike).
            if key_pressed("e") and plank_handles.length > 0:
                let mid = plank_handles[plank_handles.length / 2]
                physics.impulse(mid, vec3(0.0, 4.0, 3.0))

        on render():
            text(at: (14, 14), content: "WASD move · Shift run · Space/click attack", size: 16, color: color.white)
            text(at: (14, 36), content: "Slain: " + kills, size: 16, color: color.yellow)
            # The physics rope bridge, drawn at its live plank positions
            # (native and browser alike — rapier runs on wasm now).
            for h in plank_handles:
                cube(at: physics.position(h), color: (0.55, 0.38, 0.22), size: 0.5)
