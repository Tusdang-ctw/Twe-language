# `time.dt` is the live frame delta. Closes Phase-2 frustration F8 —
# every-clock bodies and other code can read the real dt instead of
# hardcoding `0.016`.

scene S:
    var sum = 0.0

    initial: a

    state a:
        # Interval matches the test's per-frame dt so the clock fires
        # exactly once per frame, regardless of catch-up behaviour.
        every 50ms:
            sum += time.dt
            print(sum)
