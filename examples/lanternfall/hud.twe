# @task: Lanternfall HUD module
# @inputs: none
# @expected: health and shield, the loadout cards with ammo and cooldowns, shield cells, the place name, floating words and a crosshair, laid out from screen.size
# @category: 3d
# @difficulty: medium
#
# Lanternfall — the heads-up display.
#
# Drawn over the 3D scene in HUD units: 480 tall, `screen.size.x` wide
# (wider than 640 on a widescreen window), so everything right- or
# centre-aligned is placed from `screen.size`.

import "tuning"
import "weapons"
import "world"
import "controls"
import "sounds"

let INK = (0.04, 0.05, 0.09, 0.78)
let EDGE = (1.0, 1.0, 1.0, 0.12)
let HP = (0.36, 0.86, 0.46, 1.0)
let SHIELD = (0.36, 0.7, 1.0, 1.0)
let WARM = (1.0, 0.78, 0.42, 1.0)
let DIM = (0.8, 0.85, 0.9, 0.75)

# A dark panel with a faint edge.
function chip(x, y, w, h):
    rect((x, y), (w, h), INK)
    rect_outline((x, y), (w, h), 1.0, EDGE)

# A bar `frac` full, with its value.
function bar(x, y, w, frac, fill, value):
    rect((x, y), (w, 8), (0.0, 0.0, 0.0, 0.55))
    rect((x, y), (w * math.clamp(frac, 0.0, 1.0), 8), fill)
    text("{math.floor(value)}", (x + w + 6, y + 8), 12, (0.9, 0.92, 1.0, 0.9))

# The cursor: a ring (wider while the gun kicks) with a dot.
function crosshair(spread):
    circle_outline(mouse.pos, 9.0 + spread * 6.0, 1.5, WARM)
    circle(mouse.pos, 1.6, WARM)

# One loadout card: the slot's key, its weapon and its rounds.
function card(x, y, key_label, title, detail, accent, selected, cooldown):
    let w = 92
    if selected:
        rect((x - 2, y - 2), (w + 4, 52), accent)
    chip(x, y, w, 48)
    rect((x, y), (w, 3), accent)
    text(key_label, (x + 6, y + 15), 11, DIM)
    text(title, (x + 6, y + 31), 12, (1.0, 1.0, 1.0, 0.95))
    text(detail, (x + 6, y + 44), 11, accent)
    if cooldown > 0.0:
        rect((x, y), (w, 48 * cooldown), (0.0, 0.0, 0.0, 0.55))

# Health and shield; cells; the loadout; the place; the cursor.
function draw_playing(me, place):
    let w = screen.size.x
    # Vitals, bottom-left.
    chip(12, 404, 196, 62)
    text("HP", (22, 426), 12, DIM)
    bar(48, 418, 120, me.hp / 100.0, HP, me.hp)
    text("SH", (22, 446), 12, DIM)
    bar(48, 438, 120, me.shield / 100.0, SHIELD, me.shield)
    if me.dodge_cd > 0.0:
        rect((48, 456), (120 * (1 - me.dodge_cd / tuning.DODGE_COOLDOWN), 3), WARM)
    # Shield cells, above the vitals.
    chip(12, 376, 96, 24)
    for i in 0..<me.cells:
        rect((20 + i * 14, 383), (10, 10), SHIELD)
    text("F", (88, 393), 11, DIM)
    if me.channel > 0.0:
        let cx = w / 2 - 80
        chip(cx, 300, 160, 22)
        rect((cx + 4, 312), (152 * me.channel / tuning.CELL_TIME, 6), SHIELD)
        text("charging shield", (cx + 6, 309), 11, DIM)
    # Loadout, bottom-centre: melee, two guns, Starcall.
    # (Clear of the vitals panel on a narrow window.)
    let x0 = math.max(w / 2 - 196, 218)
    for s in 0..<3:
        let id = me.guns[s]
        if id >= 0:
            let accent = weapons.RARITY_COLORS[me.rarity[s]]
            var detail = "melee"
            if weapons.magazine_of(id, me.rarity[s]) > 0:
                detail = "{me.mag[s]} / {me.reserve}"
            card(x0 + s * 98, 414, "{s + 1}", weapons.name_of(id), detail, accent, s == me.slot, 0.0)
        else:
            card(x0 + s * 98, 414, "{s + 1}", "empty", "", (0.4, 0.4, 0.45, 1.0), false, 0.0)
    let star_ready = me.star_cd <= 0.0
    let star_detail = if star_ready: "READY" else: "{math.ceil(me.star_cd)}s"
    card(x0 + 294, 414, "Q", "Starcall", star_detail, (0.75, 0.6, 1.0, 1.0), false, me.star_cd / tuning.STAR_COOLDOWN)
    if me.reload_t > 0.0:
        chip(w / 2 - 60, 388, 120, 18)
        let id = me.guns[me.slot]
        rect((w / 2 - 56, 397), (112 * (1 - me.reload_t / weapons.reload_of(id)), 5), WARM)
        text("reloading", (w / 2 - 54, 396), 11, DIM)
    # What E would do here.
    if me.prompt != "":
        let pw = me.prompt.length * 7.5 + 24
        chip(w / 2 - pw / 2, 350, pw, 24)
        text(me.prompt, (w / 2 - pw / 2 + 12, 367), 12, (1.0, 1.0, 1.0, 0.95))
    # Where you are, top-centre.
    if place != "":
        let tw = place.length * 8.0 + 24
        chip(w / 2 - tw / 2, 12, tw, 26)
        text(place, (w / 2 - tw / 2 + 12, 30), 14, WARM)
    crosshair(me.kick)
    # A hit lands: an X on the crosshair.
    if me.hit_marker > 0.0:
        let a = me.hit_marker
        let m = mouse.pos
        line((m.x - 10, m.y - 10), (m.x - 4, m.y - 4), 2.0, (1.0, 1.0, 1.0, a))
        line((m.x + 10, m.y - 10), (m.x + 4, m.y - 4), 2.0, (1.0, 1.0, 1.0, a))
        line((m.x - 10, m.y + 10), (m.x - 4, m.y + 4), 2.0, (1.0, 1.0, 1.0, a))
        line((m.x + 10, m.y + 10), (m.x + 4, m.y + 4), 2.0, (1.0, 1.0, 1.0, a))
    # Hit from somewhere: a red chevron around the keeper, pointing there.
    if me.hit_from_t > 0.0 and me.alive:
        let at = camera.project(me.pos + vec3(0, 1.0, 0))
        let to = camera.project(me.hit_from + vec3(0, 1.0, 0))
        if at != nil and to != nil:
            let dx = to.x - at.x
            let dy = to.y - at.y
            let d = math.max(0.001, math.sqrt(dx * dx + dy * dy))
            let ux = dx / d
            let uy = dy / d
            let tip = (at.x + ux * 62.0, at.y + uy * 62.0)
            let back = (at.x + ux * 48.0, at.y + uy * 48.0)
            let side = (-uy * 9.0, ux * 9.0)
            let c = (1.0, 0.25, 0.2, me.hit_from_t)
            line((back[0] + side[0], back[1] + side[1]), tip, 3.0, c)
            line((back[0] - side[0], back[1] - side[1]), tip, 3.0, c)

# Floating words over the world ("CRACKED"), where their point projects.
function draw_popups(popups):
    for p in popups:
        let at = camera.project(p.pos)
        if at != nil:
            let fade = math.clamp(1.0 - p.age / 0.9, 0.0, 1.0)
            let w = p.word.length * p.size * 0.5
            text(p.word, (at.x - w / 2 + 1, at.y + 1), p.size, (0.0, 0.0, 0.0, 0.6 * fade))
            text(p.word, (at.x - w / 2, at.y), p.size, (p.color[0], p.color[1], p.color[2], fade))

# Name tags and health pips over the rivals near the keeper.
function draw_tags(rivals, me):
    for b in rivals:
        if b.alive:
            let dx = b.pos.x - me.pos.x
            let dz = b.pos.z - me.pos.z
            if dx * dx + dz * dz < 26.0 * 26.0:
                let at = camera.project(b.pos + vec3(0, 2.05, 0))
                if at != nil:
                    let w = b.name.length * 6.0
                    text(b.name, (at.x - w / 2 + 1, at.y + 1), 11, (0.0, 0.0, 0.0, 0.7))
                    text(b.name, (at.x - w / 2, at.y), 11, (1.0, 1.0, 1.0, 0.9))
                    rect((at.x - 18, at.y + 4), (36, 3), (0.0, 0.0, 0.0, 0.6))
                    rect((at.x - 18, at.y + 4), (36 * b.hp / 100.0, 3), HP)
                    if b.shield > 0.0:
                        rect((at.x - 18, at.y + 8), (36 * b.shield / 100.0, 2), SHIELD)

# Alive and kills, top-right; the kill feed, top-left.
function draw_match(alive, kills, feed, now):
    let w = screen.size.x
    chip(w - 150, 12, 138, 26)
    text("{alive} ALIVE", (w - 142, 30), 13, (1.0, 1.0, 1.0, 0.95))
    text("{kills} KILLS", (w - 72, 30), 13, WARM)
    var shown = 0
    var i = feed.length - 1
    while i >= 0 and shown < 5:
        let e = feed[i]
        let age = now - e[4]
        if age < 7.0:
            let fade = math.clamp((7.0 - age) / 1.5, 0.0, 1.0)
            let line = "{e[0]}  >  {e[1]}"
            let color = if e[2]: WARM else: (if e[3]: (1.0, 0.4, 0.4, 1.0) else: (0.85, 0.88, 0.95, 1.0))
            chip(12, 12 + shown * 22, line.length * 6.6 + 16, 19)
            text(line, (20, 26 + shown * 22), 11, (color[0], color[1], color[2], fade))
            shown += 1
        i -= 1

# ---------------------------------------------------------------
# Lanternfall G4: the round's HUD.
# ---------------------------------------------------------------

# Big moments, newest last: (text, colour, when). `banner` adds one;
# `draw_banners` shows the newest for 2.6 s.
var banners = []

function banner(words, color):
    banners.append((words, color, sound.now()))
    sounds.sfx(sounds.BANNER, 0.6)

function draw_banners(now):
    if banners.length == 0:
        return
    let b = banners[banners.length - 1]
    let age = now - b[2]
    if age < 2.6:
        let w = screen.size.x
        let grow = math.min(1.0, age * 6.0)
        let fade = math.clamp((2.6 - age) / 0.5, 0.0, 1.0)
        let size = 26.0 * (0.8 + 0.2 * grow)
        let tw = b[0].length * size * 0.52
        rect((w / 2 - tw / 2 - 18, 92), (tw + 36, 40), (0.03, 0.03, 0.07, 0.75 * fade))
        rect((w / 2 - tw / 2 - 18, 92), (tw + 36, 3), (b[1][0], b[1][1], b[1][2], fade))
        text(b[0], (w / 2 - tw / 2, 121), size, (b[1][0], b[1][1], b[1][2], fade))

# A keycap and what it does, centred low on the screen.
function prompt(key_label, words, y):
    let w = screen.size.x
    let tw = words.length * 8.0 + 52
    chip(w / 2 - tw / 2, y, tw, 28)
    rect((w / 2 - tw / 2 + 6, y + 5), (34, 18), (0.9, 0.9, 0.95, 0.9))
    text(key_label, (w / 2 - tw / 2 + 9, y + 19), 11, (0.05, 0.05, 0.08, 1.0))
    text(words, (w / 2 - tw / 2 + 46, y + 19), 13, (1.0, 1.0, 1.0, 0.95))

# Aboard the barge: leap, what's below, how long until it turns back.
function draw_aboard(b, below):
    if b == nil:
        return
    prompt(controls.cap_of(controls.LEAP), "Leap from the barge", 330)
    var where = "the wilds"
    if below != "":
        where = below
    let left = math.max(0.0, b.time_left())
    let line = "Below: {where}  ·  the barge turns back in {math.ceil(left)}s"
    text(line, (screen.size.x / 2 - line.length * 3.3, 376), 12, DIM)
    crosshair(0.0)

# Gliding down: how high, and where you'll come down.
function draw_glide(me, below):
    let w = screen.size.x
    chip(w / 2 - 70, 330, 140, 26)
    text("{math.ceil(me.pos.y)} m", (w / 2 - 60, 348), 14, WARM)
    if below != "":
        text(below, (w / 2 - 5, 348), 12, DIM)
    let keys = "{controls.cap_of(controls.UP)}{controls.cap_of(controls.LEFT)}{controls.cap_of(controls.DOWN)}{controls.cap_of(controls.RIGHT)}"
    text("{keys} to steer", (w / 2 - 44, 376), 11, DIM)

# The Hush: when it moves next, and a violet edge when you're outside.
function draw_hush(h, me, stage):
    if stage != "playing" or not h.running:
        return
    let w = screen.size.x
    var label = "THE HUSH CLOSES IN"
    if not h.waiting:
        label = "THE HUSH IS CLOSING"
    let secs = math.ceil(math.max(0.0, h.timer))
    let mins = math.floor(secs / 60)
    let rest = math.mod(secs, 60)
    let pad = if rest < 10: "0" else: ""
    let line = "{label}  {mins}:{pad}{rest}"
    let tw = line.length * 7.0 + 24
    chip(w / 2 - tw / 2, 44, tw, 22)
    text(line, (w / 2 - tw / 2 + 12, 59), 12, (0.8, 0.65, 1.0, 1.0))
    if h.outside(me.pos) and me.alive:
        let pulse = 0.35 + 0.15 * math.sin(sound.now() * 6.0)
        rect((0, 0), (w, 10), (0.55, 0.25, 1.0, pulse))
        rect((0, 470), (w, 10), (0.55, 0.25, 1.0, pulse))
        rect((0, 0), (10, 480), (0.55, 0.25, 1.0, pulse))
        rect((w - 10, 0), (10, 480), (0.55, 0.25, 1.0, pulse))
        text("OUTSIDE THE HUSH", (w / 2 - 64, 86), 13, (0.85, 0.65, 1.0, 1.0))

# The minimap, top-right: the island, its places, the Hush, the barge's
# line, and you.
function draw_map(me, h, b, places):
    let w = screen.size.x
    let size = 112.0
    let x0 = w - 12 - size
    let y0 = 44.0
    let scale = size / (tuning.BEACH_HALF * 2.0)
    rect((x0 - 3, y0 - 3), (size + 6, size + 6), INK)
    rect((x0, y0), (size, size), (0.05, 0.12, 0.2, 0.9))
    let beach = tuning.BEACH_HALF * scale
    let grass = tuning.ISLAND_HALF * scale
    let cx = x0 + size / 2
    let cy = y0 + size / 2
    rect((cx - beach, cy - beach), (beach * 2, beach * 2), (0.55, 0.5, 0.38, 0.9))
    rect((cx - grass, cy - grass), (grass * 2, grass * 2), (0.16, 0.3, 0.18, 0.95))
    # Roads and buildings.
    for b in world.BLOCKS:
        let bw = math.max(1.0, b[3] * scale)
        let bd = math.max(1.0, b[4] * scale)
        let tone = if b[0] == 4: (0.4, 0.38, 0.36, 0.9) else: (0.12, 0.11, 0.14, 0.95)
        rect((cx + b[1] * scale - bw / 2, cy + b[2] * scale - bd / 2), (bw, bd), tone)
    for p in places:
        circle((cx + p[1] * scale, cy + p[2] * scale), 2.5, (0.9, 0.8, 0.55, 0.9))
        text(p[5], (cx + p[1] * scale + 4, cy + p[2] * scale + 3), 9, (1.0, 0.92, 0.7, 0.85))
    if h.running:
        if h.radius * scale < size * 0.5:
            circle_outline((cx + h.pos.x * scale, cy + h.pos.z * scale), math.max(1.0, h.radius * scale), 1.5, (0.75, 0.5, 1.0, 0.95))
        circle_outline((cx + h.next_center.x * scale, cy + h.next_center.z * scale), math.max(1.0, h.next_radius * scale), 1.0, (1.0, 1.0, 1.0, 0.7))
    if b != nil:
        let a = b.pos - b.dir * 200.0
        let z = b.pos + b.dir * 200.0
        line((cx + a.x * scale, cy + a.z * scale), (cx + z.x * scale, cy + z.z * scale), 1.0, (1.0, 0.85, 0.5, 0.5))
        circle((cx + b.pos.x * scale, cy + b.pos.z * scale), 3.0, (1.0, 0.85, 0.5, 1.0))
    let px = cx + me.pos.x * scale
    let py = cy + me.pos.z * scale
    circle((px, py), 3.0, (1.0, 1.0, 1.0, 1.0))
    line((px, py), (px + math.sin(me.heading) * 7.0, py + math.cos(me.heading) * 7.0), 1.5, (1.0, 1.0, 1.0, 1.0))

# The round's end: win or placement, kills, damage, time; play again.
# The end of the round: how you placed, what you did, your best. The
# menu under it (Play again / Back to the title) is the menus module's.
function draw_results(won, placement, kills, damage, secs, best, new_best):
    let w = screen.size.x
    rect((0, 0), (w, 480), (0.0, 0.0, 0.03, 0.55))
    let x = w / 2 - 190
    chip(x, 120, 380, 212)
    var accent = (0.85, 0.42, 0.4, 1.0)
    var headline = "YOUR LANTERN WENT OUT"
    if won:
        accent = WARM
        headline = "LAST LANTERN STANDING"
    rect((x, 120), (380, 4), accent)
    text(headline, (w / 2 - headline.length * 22 * 0.26, 162), 22, accent)
    text("#{placement}", (x + 34, 238), 54, (1.0, 1.0, 1.0, 1.0))
    text("of {tuning.BOT_COUNT + 1}", (x + 38, 262), 12, DIM)
    let sx = x + 190
    let secs_part = math.mod(math.floor(secs), 60)
    let pad = if secs_part < 10: "0" else: ""
    let rows = [
        ("Eliminations", "{kills}"),
        ("Damage", "{math.floor(damage)}"),
        ("Survived", "{math.floor(secs / 60)}:{pad}{secs_part}"),
    ]
    for i in 0..<rows.length:
        let y = 200 + i * 26
        text(rows[i][0], (sx, y), 13, DIM)
        text(rows[i][1], (sx + 120, y), 15, (1.0, 1.0, 1.0, 0.95))
    if new_best:
        rect((x + 34, 288), (92, 22), accent)
        text("NEW BEST", (x + 44, 304), 13, (0.05, 0.05, 0.08, 1.0))
    elif best > 0:
        text("Best  #{best}", (x + 38, 304), 13, DIM)
