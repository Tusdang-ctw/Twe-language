# @task: Survive 3D — a top-down 3D survivors game (the web3d v1.0 slice)
# @inputs: WASD / arrows to move, 1/2/3 to pick upgrades, Esc to pause, R to restart
# @expected: waves of enemies chase the player; auto-weapons kill them; XP gems level you up; a boss every 5 waves
# @category: 3d
# @difficulty: large
#
# web3d-M4: the vertical slice — `survive_beta`'s design, in 3D, running
# in Chrome (`twec build --target web examples/survive3d`) and natively
# (`twec play3d examples/survive3d/main.twe`).
#
# Everything on screen is an entity with a `look:`; the scene's states
# (playing / level_up / paused / game_over) draw the HUD and menus with
# `text()` / `rect()`. World units are metres; the arena is 60 × 60 on
# the XZ plane, seen from a camera above and behind the player.

let arena = 30.0          # half-width: the arena spans -30..30 on X and Z
let player_radius = 0.5

var player = vec3(0, 0, 0)
var player_speed = 6.0
var player_hp = 100.0
var player_max_hp = 100.0
var player_iframes = 0.0
var kills = 0

var xp = 0
var xp_to_next_level = 5
var magnet_radius = 3.0
var attack_interval = 0.6
var level = 1
var frozen = false        # true while a menu is up: entities hold still
var pick_a = 0
var pick_b = 1
var pick_c = 2

var weapon_time = 0.0
var best_wave = 1
var best_time = 0.0
var boss_wave_counter = 0

random.seed(20260928)

function take_player_damage(amount):
    player_hp -= amount
    player_iframes = 0.6

# Distance² on the ground plane.
function d2(a, b):
    let dx = a.x - b.x
    let dz = a.z - b.z
    return dx * dx + dz * dz

# A step of `speed * dt` from `from` toward `to`, on the ground plane.
function step_toward(from, to, speed, dt):
    let dx = to.x - from.x
    let dz = to.z - from.z
    let mag = math.sqrt(dx * dx + dz * dz)
    if mag < 0.001:
        return from
    let s = speed * dt / mag
    return vec3(from.x + dx * s, 0, from.z + dz * s)

function upgrade_name(id):
    if id == 0:
        return "Faster Attack  (-15% cooldown)"
    elif id == 1:
        return "Wider Magnet   (+1.5 m)"
    elif id == 2:
        return "Tougher Hide   (+20 max HP)"
    elif id == 3:
        return "Swift Feet     (+1 m/s)"
    elif id == 4:
        return "Quick Heal     (full HP)"
    elif id == 5:
        return "Orbiting Blade (+1 blade)"
    return "Damaging Aura  (new / faster)"

function apply_upgrade(id):
    if id == 0:
        attack_interval *= 0.85
        if attack_interval < 0.1:
            attack_interval = 0.1
    elif id == 1:
        magnet_radius += 1.5
    elif id == 2:
        player_max_hp += 20.0
        player_hp += 20.0
    elif id == 3:
        player_speed += 1.0
    elif id == 4:
        player_hp = player_max_hp
    elif id == 5:
        spawn Blade at player
        var count = 0
        for b in entities.of(Blade):
            count += 1
        var i = 0
        for b in entities.of(Blade):
            b.phase = i * 6.2831853 / count
            i += 1
    else:
        var has_aura = false
        for a in entities.of(Aura):
            has_aura = true
            a.tick_interval *= 0.85
            if a.tick_interval < 0.1:
                a.tick_interval = 0.1
        if not has_aura:
            spawn Aura at player

# A point just outside the camera's view, inside the arena.
function spawn_point():
    let angle = random.float() * 6.2831853
    let r = 18.0 + random.float() * 4.0
    var x = player.x + r * math.cos(angle)
    var z = player.z + r * math.sin(angle)
    x = math.clamp(x, -arena, arena)
    z = math.clamp(z, -arena, arena)
    return vec3(x, 0, z)

# ---------------------------------------------------------------
# Enemies. Each chases the player and hurts on contact.
# ---------------------------------------------------------------
entity Slime:
    var pos = vec3(0, 0, 0)
    var speed = 2.2
    var damage = 8.0
    var reach = 0.9
    look:
        mesh: "sphere"
        tint: (0.25, 0.85, 0.45)
        scale: 0.9

    function update(dt):
        if frozen:
            return
        pos = step_toward(pos, player, speed, dt)
        if d2(pos, player) < reach * reach and player_iframes <= 0.0:
            take_player_damage(damage)

# Fast, weaving flier.
entity Bat:
    var pos = vec3(0, 0, 0)
    var damage = 5.0
    var weave = 0.0
    var heading = 0.0
    look:
        mesh: "cube"
        tint: (0.6, 0.3, 0.85)
        scale: 0.5
        facing: heading

    function update(dt):
        if frozen:
            return
        let dx = player.x - pos.x
        let dz = player.z - pos.z
        let mag = math.sqrt(dx * dx + dz * dz)
        if mag < 0.001:
            return
        let nx = dx / mag
        let nz = dz / mag
        weave += dt * 5.0
        let side = math.sin(weave) * 1.2
        let speed = 4.0
        pos = vec3(pos.x + (nx * speed - nz * side) * dt, 0, pos.z + (nz * speed + nx * side) * dt)
        heading = math.atan2(nx, nz)
        if mag < 0.8 and player_iframes <= 0.0:
            take_player_damage(damage)

# Slow and tough; takes two hits.
entity Skeleton:
    var pos = vec3(0, 0, 0)
    var hp = 2
    var damage = 12.0
    var heading = 0.0
    look:
        mesh: "cube"
        tint: (0.9, 0.88, 0.8)
        scale: 0.9
        facing: heading

    function update(dt):
        if frozen:
            return
        let before = pos
        pos = step_toward(pos, player, 1.6, dt)
        heading = math.atan2(pos.x - before.x, pos.z - before.z)
        if d2(pos, player) < 1.0 and player_iframes <= 0.0:
            take_player_damage(damage)

entity Boss:
    var pos = vec3(0, 0, 0)
    var hp = 60.0
    var heading = 0.0
    look:
        mesh: "cube"
        tint: (0.85, 0.15, 0.15)
        scale: 2.4
        facing: heading

    function update(dt):
        if frozen:
            return
        let before = pos
        pos = step_toward(pos, player, 1.4, dt)
        heading = math.atan2(pos.x - before.x, pos.z - before.z)
        if d2(pos, player) < 2.2 * 2.2 and player_iframes <= 0.0:
            take_player_damage(20.0)

# Hit an enemy of any kind: returns true if it died.
function hurt(e, amount):
    if e.hp <= amount:
        despawn e
        kills += 1
        return true
    e.hp -= amount
    return false

# ---------------------------------------------------------------
# Weapons.
# ---------------------------------------------------------------

# Auto-fired bolt: aims at the nearest enemy when fired, then flies
# straight (committing to the shot rewards positioning).
entity Projectile:
    var pos = vec3(0, 0, 0)
    var vel = vec3(0, 0, 0)
    var aimed = false
    var lifetime = 1.5
    look:
        mesh: "sphere"
        tint: (1.0, 0.9, 0.3)
        scale: 0.3

    function update(dt):
        if frozen:
            return
        if not aimed:
            aimed = true
            var best = 1000000.0
            var target = vec3(pos.x, 0, pos.z - 1)
            for s in entities.of(Slime):
                let d = d2(s.pos, pos)
                if d < best:
                    best = d
                    target = s.pos
            for b in entities.of(Bat):
                let d = d2(b.pos, pos)
                if d < best:
                    best = d
                    target = b.pos
            for k in entities.of(Skeleton):
                let d = d2(k.pos, pos)
                if d < best:
                    best = d
                    target = k.pos
            for b in entities.of(Boss):
                let d = d2(b.pos, pos)
                if d < best:
                    best = d
                    target = b.pos
            let dx = target.x - pos.x
            let dz = target.z - pos.z
            let mag = math.sqrt(dx * dx + dz * dz)
            if mag > 0.001:
                vel = vec3(dx / mag * 18.0, 0, dz / mag * 18.0)
            else:
                vel = vec3(0, 0, -18.0)
        pos = vec3(pos.x + vel.x * dt, 0, pos.z + vel.z * dt)
        lifetime -= dt
        if lifetime <= 0.0:
            despawn self
            return
        for s in entities.of(Slime):
            if d2(s.pos, pos) < 0.6:
                despawn s
                kills += 1
                despawn self
                return
        for b in entities.of(Bat):
            if d2(b.pos, pos) < 0.5:
                despawn b
                kills += 1
                despawn self
                return
        for k in entities.of(Skeleton):
            if d2(k.pos, pos) < 0.7:
                hurt(k, 1)
                despawn self
                return
        for b in entities.of(Boss):
            if d2(b.pos, pos) < 2.0:
                hurt(b, 5.0)
                despawn self
                return

# Orbits the player; everything it touches dies.
entity Blade:
    var pos = vec3(0, 0, 0)
    var phase = 0.0
    var radius = 2.2
    var spin = 0.0
    look:
        mesh: "cube"
        tint: (0.85, 0.9, 1.0)
        scale: 0.45
        facing: spin

    function update(dt):
        if frozen:
            return
        let a = weapon_time * 3.0 + phase
        pos = vec3(player.x + math.cos(a) * radius, 0, player.z + math.sin(a) * radius)
        spin = a * 2.0
        for s in entities.of(Slime):
            if d2(s.pos, pos) < 0.5:
                despawn s
                kills += 1
        for b in entities.of(Bat):
            if d2(b.pos, pos) < 0.5:
                despawn b
                kills += 1
        for k in entities.of(Skeleton):
            if d2(k.pos, pos) < 0.6:
                hurt(k, 1)
        for b in entities.of(Boss):
            if d2(b.pos, pos) < 2.0:
                hurt(b, 0.5)

# Pulses around the player, damaging everything within `radius`.
entity Aura:
    var pos = vec3(0, 0, 0)
    var tick_timer = 0.0
    var tick_interval = 0.5
    var radius = 3.5

    function update(dt):
        if frozen:
            return
        pos = player
        tick_timer += dt
        if tick_timer < tick_interval:
            return
        tick_timer = 0.0
        spawn Pulse at vec3(player.x, 0.05, player.z)
        let r2 = radius * radius
        for s in entities.of(Slime):
            if d2(s.pos, player) < r2:
                despawn s
                kills += 1
        for b in entities.of(Bat):
            if d2(b.pos, player) < r2:
                despawn b
                kills += 1
        for k in entities.of(Skeleton):
            if d2(k.pos, player) < r2:
                hurt(k, 1)
        for b in entities.of(Boss):
            if d2(b.pos, player) < r2:
                hurt(b, 6.0)

# ---------------------------------------------------------------
# Effects and pickups.
# ---------------------------------------------------------------

# The aura's pulse: a flat disc that grows and vanishes.
entity Pulse:
    var pos = vec3(0, 0, 0)
    var age = 0.0
    look:
        mesh: "sphere"
        tint: (0.3, 0.9, 1.0)
        scale: 0.5 + age * 20.0

    function update(dt):
        age += dt
        if age > 0.18:
            despawn self

# Death poof: shrinks to nothing.
entity Spark:
    var pos = vec3(0, 0, 0)
    var life = 0.3
    look:
        mesh: "cube"
        tint: (1.0, 0.7, 0.3)
        scale: life * 2.0
        facing: life * 20.0

    function update(dt):
        life -= dt
        if life <= 0.0:
            despawn self

entity XPGem:
    var pos = vec3(0, 0, 0)
    var value = 1
    var spin = 0.0
    look:
        mesh: "cube"
        tint: (0.3, 0.55, 1.0)
        scale: 0.4
        facing: spin

    function update(dt):
        if frozen:
            return
        spin += dt * 3.0
        let d = d2(pos, player)
        if d < 0.5:
            xp += value
            despawn self
            return
        if d < magnet_radius * magnet_radius:
            pos = step_toward(pos, player, 12.0, dt)

on Slime.death(s):
    spawn XPGem at s.pos
    spawn Spark at s.pos

on Bat.death(b):
    spawn XPGem at b.pos
    spawn Spark at b.pos

on Skeleton.death(k):
    spawn XPGem at k.pos
    spawn XPGem at vec3(k.pos.x + 0.4, 0, k.pos.z)
    spawn Spark at k.pos

on Boss.death(b):
    for i in 0..<10:
        spawn XPGem at vec3(b.pos.x + math.cos(i * 0.628) * 1.5, 0, b.pos.z + math.sin(i * 0.628) * 1.5)
    spawn Spark at b.pos

# ---------------------------------------------------------------
# The world, drawn every frame by every state.
# ---------------------------------------------------------------
function draw_world():
    # Ground: a checkerboard of 4 m tiles (top faces at y = -0.5), so
    # movement reads; only the tiles around the camera are drawn.
    let cx = math.floor(player.x / 4.0) * 4.0
    let cz = math.floor(player.z / 4.0) * 4.0
    for i in -6..6:
        for j in -6..5:
            let tx = cx + i * 4.0
            let tz = cz + j * 4.0
            if tx >= -arena - 2.0 and tx <= arena + 2.0 and tz >= -arena - 2.0 and tz <= arena + 2.0:
                var shade = 0.13
                if math.mod(math.floor(tx / 4.0) + math.floor(tz / 4.0), 2) == 0:
                    shade = 0.17
                cube(at: vec3(tx + 2.0, -2.5, tz + 2.0), color: (shade, shade * 1.05, shade * 1.2, 1.0), size: 4.0)
    var tint = (0.95, 0.95, 0.95, 1.0)
    if player_iframes > 0.0:
        tint = (1.0, 0.85, 0.3, 1.0)
    sphere(at: vec3(player.x, 0.1, player.z), color: tint, size: 1.2)
    let e = arena + 0.6
    for i in 0..<20:
        let t = -e + i * (2.0 * e / 19.0)
        cube(at: vec3(t, -0.3, -e), color: (0.35, 0.38, 0.45, 1.0), size: 0.6)
        cube(at: vec3(t, -0.3, e), color: (0.35, 0.38, 0.45, 1.0), size: 0.6)
        cube(at: vec3(-e, -0.3, t), color: (0.35, 0.38, 0.45, 1.0), size: 0.6)
        cube(at: vec3(e, -0.3, t), color: (0.35, 0.38, 0.45, 1.0), size: 0.6)

function clear_run():
    for s in entities.of(Slime):
        despawn s
    for b in entities.of(Bat):
        despawn b
    for k in entities.of(Skeleton):
        despawn k
    for b in entities.of(Boss):
        despawn b
    for p in entities.of(Projectile):
        despawn p
    for g in entities.of(XPGem):
        despawn g
    for b in entities.of(Blade):
        despawn b
    for a in entities.of(Aura):
        despawn a

scene Survive3D:
    var elapsed = 0.0
    var wave_index = 0
    var wave_timer = 0.0
    var spawn_interval = 1.5
    var attack_timer = 0.0

    initial: playing

    state playing:
        on update(dt):
            elapsed += dt
            weapon_time += dt
            if player_iframes > 0.0:
                player_iframes -= dt

            # Waves roll every 30 s: faster spawns, bigger bursts, a
            # boss every fifth wave.
            let next_wave = math.floor(elapsed / 30.0)
            if next_wave > wave_index:
                wave_index = next_wave
                spawn_interval = math.max(0.4, 1.5 - wave_index * 0.15)
                boss_wave_counter += 1
                if boss_wave_counter >= 5:
                    boss_wave_counter = 0
                    spawn Boss at spawn_point()
            wave_timer += dt
            if wave_timer >= spawn_interval:
                wave_timer = 0.0
                for i in 0..<(1 + wave_index):
                    var pool = 1
                    if wave_index >= 1:
                        pool = 2
                    if wave_index >= 3:
                        pool = 3
                    let kind = random.int(0..<pool)
                    if kind == 0:
                        spawn Slime at spawn_point()
                    elif kind == 1:
                        spawn Bat at spawn_point()
                    else:
                        spawn Skeleton at spawn_point()

            attack_timer += dt
            if attack_timer >= attack_interval:
                attack_timer = 0.0
                spawn Projectile at player

            # Movement, normalised so diagonals aren't faster.
            var mx = 0.0
            var mz = 0.0
            if key.d or key.right:
                mx += 1.0
            if key.a or key.left:
                mx -= 1.0
            if key.w or key.up:
                mz -= 1.0
            if key.s or key.down:
                mz += 1.0
            let m2 = mx * mx + mz * mz
            if m2 > 1.0:
                let m = math.sqrt(m2)
                mx = mx / m
                mz = mz / m
            let px = math.clamp(player.x + mx * player_speed * dt, -arena, arena)
            let pz = math.clamp(player.z + mz * player_speed * dt, -arena, arena)
            player = vec3(px, 0, pz)
            camera.eye = vec3(player.x, 13, player.z + 9)
            camera.target = player

            if player_hp <= 0.0:
                best_wave = math.max(best_wave, wave_index + 1)
                best_time = math.max(best_time, elapsed)
                frozen = true
                -> game_over
            if key_press.escape:
                frozen = true
                -> paused
            if xp >= xp_to_next_level:
                xp -= xp_to_next_level
                level += 1
                xp_to_next_level += 3 + level
                pick_a = random.int(0..<7)
                pick_b = pick_a + 1
                if pick_b >= 7:
                    pick_b -= 7
                pick_c = pick_a + 2
                if pick_c >= 7:
                    pick_c -= 7
                frozen = true
                -> level_up

        on render():
            draw_world()
            # HUD, in the 640 × 480 canvas.
            text("Time {math.floor(elapsed)}s", (12, 26), 18, color.white)
            text("Lv {level}", (296, 26), 18, color.cyan)
            text("Wave {wave_index + 1}", (540, 26), 18, color.yellow)
            text("Kills {kills}", (540, 48), 14, color.yellow)
            rect((10, 36), (204, 16), (0.2, 0.2, 0.2, 0.8))
            rect((12, 38), (200.0 * math.max(0.0, player_hp) / player_max_hp, 12), color.red)
            text("HP {math.floor(math.max(0.0, player_hp))}/{math.floor(player_max_hp)}", (14, 66), 12, color.white)
            rect((20, 458), (604, 12), (0.2, 0.2, 0.2, 0.8))
            rect((22, 460), (600.0 * xp / xp_to_next_level, 8), (0.3, 0.55, 1.0, 1.0))
            text("XP {xp} / {xp_to_next_level}", (270, 452), 12, color.white)

    state level_up:
        on update(dt):
            var chosen = -1
            if key_pressed("1"):
                chosen = pick_a
            elif key_pressed("2"):
                chosen = pick_b
            elif key_pressed("3"):
                chosen = pick_c
            if chosen >= 0:
                apply_upgrade(chosen)
                frozen = false
                -> playing

        on render():
            draw_world()
            rect((0, 0), (640, 480), (0.0, 0.0, 0.0, 0.6))
            text("LEVEL UP!  Lv {level}", (200, 110), 30, color.yellow)
            text("press 1, 2 or 3", (250, 140), 16, color.gray)
            text("1  {upgrade_name(pick_a)}", (150, 200), 18, color.white)
            text("2  {upgrade_name(pick_b)}", (150, 240), 18, color.white)
            text("3  {upgrade_name(pick_c)}", (150, 280), 18, color.white)

    state paused:
        on update(dt):
            if key_press.escape:
                frozen = false
                -> playing

        on render():
            draw_world()
            rect((0, 0), (640, 480), (0.0, 0.0, 0.0, 0.6))
            text("PAUSED", (262, 200), 34, color.yellow)
            text("Esc to resume", (262, 240), 16, color.gray)

    state game_over:
        on update(dt):
            if key_press.r:
                clear_run()
                player = vec3(0, 0, 0)
                player_hp = 100.0
                player_max_hp = 100.0
                player_speed = 6.0
                player_iframes = 0.0
                kills = 0
                xp = 0
                xp_to_next_level = 5
                level = 1
                magnet_radius = 3.0
                attack_interval = 0.6
                weapon_time = 0.0
                boss_wave_counter = 0
                elapsed = 0.0
                wave_index = 0
                wave_timer = 0.0
                spawn_interval = 1.5
                attack_timer = 0.0
                frozen = false
                -> playing

        on render():
            draw_world()
            rect((0, 0), (640, 480), (0.0, 0.0, 0.0, 0.7))
            text("GAME OVER", (230, 130), 36, color.red)
            text("Wave reached: {wave_index + 1}", (220, 190), 18, color.white)
            text("Survived: {math.floor(elapsed)}s", (220, 220), 18, color.white)
            text("Kills: {kills}    Level: {level}", (220, 250), 18, color.white)
            text("Best: wave {best_wave}, {math.floor(best_time)}s", (220, 290), 16, color.gray)
            text("Press R to play again", (220, 350), 16, color.gray)
