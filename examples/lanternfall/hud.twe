# @task: Lanternfall HUD module
# @inputs: none
# @expected: health and shield, the loadout cards with ammo and cooldowns, shield cells, the place name, floating words and a crosshair, laid out from screen.size
# @category: 3d
# @difficulty: medium
#
# Lanternfall — the heads-up display.
#
# Drawn over the 3D scene in HUD units: 480 tall, `screen.size.x` wide
# (wider than 640 on a widescreen window), so everything right- or
# centre-aligned is placed from `screen.size`.

import "tuning"
import "weapons"

let INK = (0.04, 0.05, 0.09, 0.78)
let EDGE = (1.0, 1.0, 1.0, 0.12)
let HP = (0.36, 0.86, 0.46, 1.0)
let SHIELD = (0.36, 0.7, 1.0, 1.0)
let WARM = (1.0, 0.78, 0.42, 1.0)
let DIM = (0.8, 0.85, 0.9, 0.75)

# A dark panel with a faint edge.
function chip(x, y, w, h):
    rect((x, y), (w, h), INK)
    rect_outline((x, y), (w, h), 1.0, EDGE)

# A bar `frac` full, with its value.
function bar(x, y, w, frac, fill, value):
    rect((x, y), (w, 8), (0.0, 0.0, 0.0, 0.55))
    rect((x, y), (w * math.clamp(frac, 0.0, 1.0), 8), fill)
    text("{math.floor(value)}", (x + w + 6, y + 8), 12, (0.9, 0.92, 1.0, 0.9))

# The cursor: a ring (wider while the gun kicks) with a dot.
function crosshair(spread):
    circle_outline(mouse.pos, 9.0 + spread * 6.0, 1.5, WARM)
    circle(mouse.pos, 1.6, WARM)

# One loadout card: the slot's key, its weapon and its rounds.
function card(x, y, key_label, title, detail, accent, selected, cooldown):
    let w = 92
    if selected:
        rect((x - 2, y - 2), (w + 4, 52), accent)
    chip(x, y, w, 48)
    rect((x, y), (w, 3), accent)
    text(key_label, (x + 6, y + 15), 11, DIM)
    text(title, (x + 6, y + 31), 12, (1.0, 1.0, 1.0, 0.95))
    text(detail, (x + 6, y + 44), 11, accent)
    if cooldown > 0.0:
        rect((x, y), (w, 48 * cooldown), (0.0, 0.0, 0.0, 0.55))

# Health and shield; cells; the loadout; the place; the cursor.
function draw_playing(me, place):
    let w = screen.size.x
    # Vitals, bottom-left.
    chip(12, 404, 196, 62)
    text("HP", (22, 426), 12, DIM)
    bar(48, 418, 120, me.hp / 100.0, HP, me.hp)
    text("SH", (22, 446), 12, DIM)
    bar(48, 438, 120, me.shield / 100.0, SHIELD, me.shield)
    if me.dodge_cd > 0.0:
        rect((48, 456), (120 * (1 - me.dodge_cd / tuning.DODGE_COOLDOWN), 3), WARM)
    # Shield cells, above the vitals.
    chip(12, 376, 96, 24)
    for i in 0..<me.cells:
        rect((20 + i * 14, 383), (10, 10), SHIELD)
    text("F", (88, 393), 11, DIM)
    if me.channel > 0.0:
        let cx = w / 2 - 80
        chip(cx, 300, 160, 22)
        rect((cx + 4, 312), (152 * me.channel / tuning.CELL_TIME, 6), SHIELD)
        text("charging shield", (cx + 6, 309), 11, DIM)
    # Loadout, bottom-centre: melee, two guns, Starcall.
    # (Clear of the vitals panel on a narrow window.)
    let x0 = math.max(w / 2 - 196, 218)
    for s in 0..<3:
        let id = me.guns[s]
        if id >= 0:
            let accent = weapons.RARITY_COLORS[me.rarity[s]]
            var detail = "melee"
            if weapons.magazine_of(id, me.rarity[s]) > 0:
                detail = "{me.mag[s]} / {me.reserve}"
            card(x0 + s * 98, 414, "{s + 1}", weapons.name_of(id), detail, accent, s == me.slot, 0.0)
        else:
            card(x0 + s * 98, 414, "{s + 1}", "empty", "", (0.4, 0.4, 0.45, 1.0), false, 0.0)
    let star_ready = me.star_cd <= 0.0
    let star_detail = if star_ready: "READY" else: "{math.ceil(me.star_cd)}s"
    card(x0 + 294, 414, "Q", "Starcall", star_detail, (0.75, 0.6, 1.0, 1.0), false, me.star_cd / tuning.STAR_COOLDOWN)
    if me.reload_t > 0.0:
        chip(w / 2 - 60, 388, 120, 18)
        let id = me.guns[me.slot]
        rect((w / 2 - 56, 397), (112 * (1 - me.reload_t / weapons.reload_of(id)), 5), WARM)
        text("reloading", (w / 2 - 54, 396), 11, DIM)
    # Where you are, top-centre.
    if place != "":
        let tw = place.length * 8.0 + 24
        chip(w / 2 - tw / 2, 12, tw, 26)
        text(place, (w / 2 - tw / 2 + 12, 30), 14, WARM)
    crosshair(me.kick)

# Floating words over the world ("CRACKED"), where their point projects.
function draw_popups(popups):
    for p in popups:
        let at = camera.project(p.pos)
        if at != nil:
            let fade = math.clamp(1.0 - p.age / 0.9, 0.0, 1.0)
            let w = p.word.length * p.size * 0.5
            text(p.word, (at.x - w / 2 + 1, at.y + 1), p.size, (0.0, 0.0, 0.0, 0.6 * fade))
            text(p.word, (at.x - w / 2, at.y), p.size, (p.color[0], p.color[1], p.color[2], fade))

# Name tags and health pips over the rivals near the keeper.
function draw_tags(rivals, me):
    for b in rivals:
        if b.alive:
            let dx = b.pos.x - me.pos.x
            let dz = b.pos.z - me.pos.z
            if dx * dx + dz * dz < 26.0 * 26.0:
                let at = camera.project(b.pos + vec3(0, 2.05, 0))
                if at != nil:
                    let w = b.name.length * 6.0
                    text(b.name, (at.x - w / 2 + 1, at.y + 1), 11, (0.0, 0.0, 0.0, 0.7))
                    text(b.name, (at.x - w / 2, at.y), 11, (1.0, 1.0, 1.0, 0.9))
                    rect((at.x - 18, at.y + 4), (36, 3), (0.0, 0.0, 0.0, 0.6))
                    rect((at.x - 18, at.y + 4), (36 * b.hp / 100.0, 3), HP)
                    if b.shield > 0.0:
                        rect((at.x - 18, at.y + 8), (36 * b.shield / 100.0, 2), SHIELD)

# Alive and kills, top-right; the kill feed, top-left.
function draw_match(alive, kills, feed, now):
    let w = screen.size.x
    chip(w - 150, 12, 138, 26)
    text("{alive} ALIVE", (w - 142, 30), 13, (1.0, 1.0, 1.0, 0.95))
    text("{kills} KILLS", (w - 72, 30), 13, WARM)
    var shown = 0
    var i = feed.length - 1
    while i >= 0 and shown < 5:
        let e = feed[i]
        let age = now - e[4]
        if age < 7.0:
            let fade = math.clamp((7.0 - age) / 1.5, 0.0, 1.0)
            let line = "{e[0]}  >  {e[1]}"
            let color = if e[2]: WARM else: (if e[3]: (1.0, 0.4, 0.4, 1.0) else: (0.85, 0.88, 0.95, 1.0))
            chip(12, 12 + shown * 22, line.length * 6.6 + 16, 19)
            text(line, (20, 26 + shown * 22), 11, (color[0], color[1], color[2], fade))
            shown += 1
        i -= 1
