# The five places: (name, x, z, radius, loot tier 1-3).
let PLACES = [
    ("Signal Vault", 0.0, 0.0, 16.0, 3),
    ("Lantern Docks", 8.0, 92.0, 26.0, 2),
    ("Glasshouse Observatory", -62.0, -58.0, 22.0, 2),
    ("Rust Hangars", 76.0, -10.0, 26.0, 2),
    ("Sunken Chapel", -72.0, 36.0, 22.0, 2),
]

# Lantern posts: (x, z, turn). Each gets a warm point light.
let LANTERNS = [
    (-4.0, 16.0, 0.0), (4.0, 30.0, 3.14), (-4.0, 46.0, 0.0), (4.0, 62.0, 3.14), (-4.0, 76.0, 0.0),
    (6.0, 98.0, 3.14), (10.0, 108.0, 0.0), (10.0, 122.0, 0.0), (-14.0, 104.0, 3.14),
    (-16.0, -14.0, 1.57), (-30.0, -26.0, 0.0), (-36.0, -44.0, 3.14), (-50.0, -50.0, 1.57), (-70.0, -66.0, 0.0),
    (16.0, -4.0, 1.57), (32.0, -12.0, 0.0), (48.0, -4.0, 3.14), (62.0, -12.0, 0.0), (84.0, 8.0, 1.57),
    (-16.0, 20.0, 1.57), (-32.0, 28.0, 0.0), (-50.0, 20.0, 3.14), (-64.0, 28.0, 0.0), (-80.0, 48.0, 1.57),
    (14.0, 14.0, 1.57), (-14.0, -14.0, 1.57),
]

# Is (x, z) clear of every solid block and road, by `margin` metres —
# where a tree, rock or crate may stand?
function clear_ground(x, z, margin):
    if math.abs(x) > tuning.ISLAND_HALF - 3 or math.abs(z) > tuning.ISLAND_HALF - 3:
        return false
    for b in BLOCKS:
        let half_w = b[3] / 2 + margin
        let half_d = b[4] / 2 + margin
        if math.abs(x - b[1]) < half_w and math.abs(z - b[2]) < half_d:
            return false
    return true

# The place (x, z) is in, or "" in the wilds.
function place_at(x, z):
    for p in PLACES:
        let dx = x - p[1]
        let dz = z - p[2]
        if dx * dx + dz * dz < p[3] * p[3]:
            return p[0]
    return ""
