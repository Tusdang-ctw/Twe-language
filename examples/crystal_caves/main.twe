# @task: First-person 3D cave exploration with crystal pickups
# @inputs: WASD + mouse-look + space jump; collect crystals before HP runs out
# @expected: walk through pillared cave; pick up 10 crystals; spike traps damage HP
# @category: 3d
# @difficulty: medium
#
# CrystalCaves — small first-person 3D cave-crawl.
#
# TweGame Track D sessions D1–D5 scaffold. The player explores a
# small cave layout with rapier3d physics. Glowing crystals (Phase
# 20 point lights) light the way. Pressure-plate traps drop spikes
# from the ceiling; touching a spike costs 1 HP. Win condition:
# collect 10 crystals and reach the exit.
#
# Reference: `examples/crystal_hunter.twe` is the upstream canonical
# version (sentinels + Phase 17–26 stack). CrystalCaves drops the
# sentinels for spike-trap mechanics and tightens scope to ~500
# lines + ~6 minutes per run.
#
# Run with:  twec play3d examples/crystal_caves/

# === Persistent best score (crystals collected this session) ===
save.try_read("crystal_caves.save")
if not save.has("best_score"):
    save.int("best_score", 0)
let best_score = save.get_int("best_score")

# === Cave layout ===
# 30m × 30m floor with four cover pillars + a center pillar that
# acts as the exit shrine.
let floor = physics.static_box((0.0, -0.5, 0.0), (30.0, 1.0, 30.0))
let wall_n = physics.static_box((0.0, 1.5, -15.0), (30.0, 3.0, 1.0))
let wall_s = physics.static_box((0.0, 1.5,  15.0), (30.0, 3.0, 1.0))
let wall_e = physics.static_box(( 15.0, 1.5, 0.0), (1.0, 3.0, 30.0))
let wall_w = physics.static_box((-15.0, 1.5, 0.0), (1.0, 3.0, 30.0))

let pillar_a = physics.static_box((-7.0, 1.5, -7.0), (1.5, 3.0, 1.5))
let pillar_b = physics.static_box(( 7.0, 1.5, -7.0), (1.5, 3.0, 1.5))
let pillar_c = physics.static_box((-7.0, 1.5,  7.0), (1.5, 3.0, 1.5))
let pillar_d = physics.static_box(( 7.0, 1.5,  7.0), (1.5, 3.0, 1.5))
let exit_shrine = physics.static_box((0.0, 0.75, 0.0), (1.5, 1.5, 1.5))

# === Crystals — collectible static sensors ===
var crystal_positions = [
    (-12.0, 0.6, -12.0),
    ( 12.0, 0.6, -12.0),
    (-12.0, 0.6,  12.0),
    ( 12.0, 0.6,  12.0),
    (  0.0, 0.6, -10.0),
    (  0.0, 0.6,  10.0),
    (-10.0, 0.6,   0.0),
    ( 10.0, 0.6,   0.0),
    (  4.0, 0.6,   6.0),
    ( -4.0, 0.6,  -6.0),
]
var crystals = []
for p in crystal_positions:
    list.push(crystals, physics.static_sphere(p, 0.5))
var crystals_collected = 0
let total_crystals = list.length(crystals)

# === Trap positions ===
# Pressure-plate trigger sensors. Walking onto one damages HP.
var trap_positions = [
    (  5.0, 0.1,  -3.0),
    ( -5.0, 0.1,   3.0),
    (  0.0, 0.1,   5.0),
    (  3.0, 0.1,   8.0),
]
var trap_iframes = 0.0

# === Player + camera state ===
var yaw = 0.0
var pitch = 0.0
var player_hp = 3
let player = physics.character((0.0, 1.0, -12.0), 1.8, 0.4)

cursor.lock()
camera.eye = vec3(0.0, 1.6, 0.0)
camera.target = vec3(0.0, 1.6, -1.0)
camera.up = vec3(0.0, 1.0, 0.0)

let mouse_sens = 0.0025
let walk_speed = 4.0
let jump_speed = 5.0

# === Lighting ===
# Ambient sun + each crystal glows as a point light. 4 crystal
# lights + 1 sun = 5 of the 8-light budget; rest reserved for
# exit-shrine glow + future torch placements.
sun.direction(vec3(-0.3, -1.0, -0.4))
sun.color(0.6, 0.55, 0.5)
sun.shadow(true)
postfx.bloom(true)
postfx.bloom_threshold(0.8)
postfx.vignette(0.35)

# Place a point light at the exit shrine.
light.point(0, vec3(0.0, 2.0, 0.0), color.cyan, 6.0)

var time = 0.0
var won = false

on update(dt):
    time += dt

    # Mouse-look.
    yaw -= mouse.dx * mouse_sens
    pitch -= mouse.dy * mouse_sens
    if pitch > 1.5: pitch = 1.5
    if pitch < -1.5: pitch = -1.5

    let fwd_x = math.sin(yaw)
    let fwd_z = math.cos(yaw)
    let right_x = math.cos(yaw)
    let right_z = -math.sin(yaw)

    # WASD movement on the XZ plane.
    var dx = 0.0
    var dz = 0.0
    if key.w:
        dx -= fwd_x * walk_speed * dt
        dz -= fwd_z * walk_speed * dt
    if key.s:
        dx += fwd_x * walk_speed * dt
        dz += fwd_z * walk_speed * dt
    if key.a:
        dx -= right_x * walk_speed * dt
        dz -= right_z * walk_speed * dt
    if key.d:
        dx += right_x * walk_speed * dt
        dz += right_z * walk_speed * dt

    # Gravity + jump (kinematic — we apply the delta ourselves).
    var dy = -9.8 * dt
    if key_press.space:
        dy = jump_speed * dt

    physics.character_move(player, dx, dy, dz)

    # Camera follows the character.
    let pp = physics.position(player)
    camera.eye = vec3(pp.x, pp.y + 0.6, pp.z)
    camera.target = vec3(
        pp.x - fwd_x,
        pp.y + 0.6 + math.sin(pitch),
        pp.z - fwd_z,
    )

    # Crystal pickup — sphere-overlap test. Mutate `crystal_positions`
    # via `.set(i, value)` (Twe lists are mutated through the method,
    # not via `list[i] = value` which isn't supported).
    var i = 0
    while i < list.length(crystal_positions):
        let cp = crystal_positions[i]
        if cp.y > -50.0:
            let ddx = pp.x - cp.x
            let ddy = pp.y - cp.y
            let ddz = pp.z - cp.z
            let d2 = ddx * ddx + ddy * ddy + ddz * ddz
            if d2 < 1.4 * 1.4:
                # Mark collected by lifting the crystal out of reach so
                # the same proximity check doesn't refire next frame.
                crystal_positions.set(i, (cp.x, -100.0, cp.z))
                crystals_collected += 1
        i += 1

    # Spike trap — proximity-trigger.
    trap_iframes -= dt
    if trap_iframes <= 0.0:
        var j = 0
        while j < list.length(trap_positions):
            let tp = trap_positions[j]
            let tdx = pp.x - tp.x
            let tdz = pp.z - tp.z
            if tdx * tdx + tdz * tdz < 0.8 * 0.8:
                player_hp -= 1
                trap_iframes = 1.2
                if player_hp <= 0:
                    won = false
            j += 1

    # Win check: all crystals + on the exit shrine.
    if crystals_collected >= total_crystals:
        if math.abs(pp.x) < 1.0 and math.abs(pp.z) < 1.0:
            won = true

    if key_press.r:
        # Reset. Restore each crystal to its original y from the
        # initial layout (the x / z are preserved through the lifted
        # state so we just bring y back).
        for k in 0..total_crystals:
            let cur = crystal_positions[k]
            crystal_positions.set(k, (cur.x, 0.6, cur.z))
        crystals_collected = 0
        player_hp = 3
        won = false
        physics.set_position(player, (0.0, 1.0, -12.0))

on render():
    # Floor + walls + pillars.
    cube(at: (0, -0.5, 0), size: (30, 1, 30), color: color.gray)
    cube(at: (-7.0, 1.5, -7.0), size: (1.5, 3, 1.5), color: color.gray)
    cube(at: ( 7.0, 1.5, -7.0), size: (1.5, 3, 1.5), color: color.gray)
    cube(at: (-7.0, 1.5,  7.0), size: (1.5, 3, 1.5), color: color.gray)
    cube(at: ( 7.0, 1.5,  7.0), size: (1.5, 3, 1.5), color: color.gray)

    # Exit shrine — pulses with time.
    let pulse = 0.7 + 0.3 * math.sin(time * 2.0)
    cube(
        at: (0, 0.75, 0),
        size: (1.5, 1.5, 1.5),
        color: color.cyan,
    )

    # Crystals.
    var i = 0
    while i < list.length(crystal_positions):
        let cp = crystal_positions[i]
        if cp.y > -50.0:
            sphere(
                at: (cp.x, cp.y + 0.2 * math.sin(time * 3.0 + i), cp.z),
                radius: 0.3,
                color: color.cyan,
            )
        i += 1

    # Trap positions — visible as flat red squares.
    var j = 0
    while j < list.length(trap_positions):
        let tp = trap_positions[j]
        cube(
            at: (tp.x, 0.05, tp.z),
            size: (1.0, 0.1, 1.0),
            color: color.red,
        )
        j += 1

    # HUD — drawn in screen-space (text() in play3d treats `at:`
    # as pixel coordinates over the rendered scene).
    text(
        "CRYSTAL CAVES",
        at: (16, 16),
        size: 18,
        color: color.white,
    )
    text(
        "crystals: {crystals_collected} / {total_crystals}",
        at: (16, 40),
        size: 14,
        color: color.cyan,
    )
    text(
        "hp: {player_hp}    best: {best_score}",
        at: (16, 60),
        size: 14,
        color: color.yellow,
    )
    if crystals_collected >= total_crystals:
        text(
            "Step onto the cyan shrine to escape.",
            at: (16, 90),
            size: 14,
            color: color.green,
        )
    if won:
        text(
            "ESCAPED",
            at: (260, 200),
            size: 32,
            color: color.green,
        )
        text(
            "press R to restart",
            at: (245, 240),
            size: 14,
            color: color.gray,
        )
    if player_hp <= 0:
        text(
            "GAME OVER",
            at: (245, 200),
            size: 32,
            color: color.red,
        )
        text(
            "press R to restart",
            at: (245, 240),
            size: 14,
            color: color.gray,
        )
    text(
        "WASD move, mouse look, space jump",
        at: (16, 440),
        size: 12,
        color: color.gray,
    )

