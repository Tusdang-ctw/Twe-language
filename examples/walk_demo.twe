# @task: Walk-cycle spritesheet animation
# @inputs: arrow keys
# @expected: character walks through 4-frame cycle while moving
# @category: 2d
# @difficulty: small
#
# Phase 11 session 8 — spritesheet walk-cycle animation.
#
# Run with `twec play examples/walk_demo.twe`. Closes the Phase 9
# follow-on for a real spritesheet animation demo (the original
# `atlas_demo.twe` used a degenerate 1x1 grid against `hero.png`).
#
# Animation timing pattern: `frame: floor(t * fps) % count`. At
# 10 fps with 8 frames the cycle takes 0.8s. The walk sheet itself
# is generated by `tests/gen_walk_sheet.rs` and committed to
# `examples/assets/walk.png` — 8 frames of 32x32 in a 256x32 strip.

let walk = load_atlas("examples/assets/walk.png", (8, 1))

var t = 0.0
var frame = 0
var step_timer = 0.0

on update(dt):
    t = t + dt
    step_timer = step_timer + dt
    if step_timer >= 0.1:
        step_timer = 0.0
        frame = frame + 1
        if frame >= 8:
            frame = 0

on render():
    # Native cell size at four positions across the screen.
    sprite_frame(walk, (60, 200), frame)
    sprite_frame(walk, (160, 200), frame)
    sprite_frame(walk, (260, 200), frame)
    sprite_frame(walk, (360, 200), frame)

    # Scaled-up draw at twice the native cell size so the
    # animation reads at a glance.
    sprite_frame_at(walk, (480, 180), (96, 96), frame)

    # Live readout.
    text("frame: {frame}", at: (10, 20), size: 18, color: color.white)
    text("t: {t}s", at: (10, 44), size: 14, color: color.gray)
