# @task: Lanternfall — a top-down 3D voxel battle royale on a night island lit by lanterns
# @inputs: menus by mouse, arrows / Enter or gamepad; Space leap, WASD move / steer, mouse aim, left click fire, E open / pick up, R reload / play again, 1-3 / wheel switch, Shift roll, Q Starcall, hold F shield cell, Esc pause (keys rebindable in Settings)
# @expected: a title screen, then a full round: leap from the lantern barge, glide down, loot chests, fight 31 rivals as the Hush closes in over five phases, until one is left
# @category: 3d
# @difficulty: large
#
# Run:   twec play3d examples/lanternfall/main.twe
# Web:   twec build --target web examples/lanternfall   (then serve dist/web)
#
# The main file owns the world — it spawns everything, holds the match
# state and the handlers; the modules hold classes, data and functions.

import "tuning"
import "world"
import "player"
import "weapons"
import "combat"
import "bots"
import "names"
import "loot"
import "round"
import "hud"
import "controls"
import "sounds"
import "menus"

random.seed(20261103)
auto_pause_on_blur(true)
quit_on_escape(false)

# ---------------------------------------------------------------
# Night lighting.
# ---------------------------------------------------------------
light.clear()
light.background((0.012, 0.016, 0.04))
light.environment("assets/night.hdr", 0.9)  # the night sky lights everything softly
light.ambient((0.03, 0.035, 0.06, 1.0))
sun.direction(vec3(-0.35, 0.8, 0.45))   # a low moon
sun.intensity(0.34)
sun.shadow(true)
sun.shadow_extent(26.0)
light.fog(0.012, 0.08, (0.05, 0.07, 0.12))
postfx.tonemap("agx")
postfx.bloom(0.45)
postfx.ao(0.9)
postfx.vignette(0.32)
postfx.vignette_color((0.02, 0.02, 0.08))
camera.fov = tuning.CAM_FOV
camera.far = 400.0

# ---------------------------------------------------------------
# Settings and the record: in the player's data folder (localStorage
# in the browser), so they survive restarts.
# ---------------------------------------------------------------
let DATA = os.data_dir("lanternfall")
let SETTINGS_PATH = DATA + "/settings.json"
let RECORD_PATH = DATA + "/record.json"
settings.set_default("vol.master", 0.8)
settings.set_default("vol.music", 0.6)
settings.set_default("vol.sfx", 0.8)
settings.set_default("gfx.quality", "auto")
settings.set_default("fx.shake", true)
for a in controls.ACTIONS:
    settings.set_default(a[0], a[2])
settings.try_load(SETTINGS_PATH)

var quality_now = ""

# Push the settings into the game: volumes, quality, shake, the keys.
function apply_settings():
    sounds.master_volume = settings.get("vol.master")
    sounds.music_volume = settings.get("vol.music")
    sounds.effects_volume = settings.get("vol.sfx")
    combat.shake_scale = if settings.get("fx.shake"): 1.0 else: 0.0
    for i in 0..<controls.ACTIONS.length:
        controls.keys.set(i, settings.get(controls.ACTIONS[i][0]))
    # Changing tier rebuilds GPU targets: only when it really changed.
    if settings.get("gfx.quality") != quality_now:
        quality_now = settings.get("gfx.quality")
        graphics.quality(quality_now)

apply_settings()

var best_place = 0        # 0 until a round is finished
var best_kills = 0
var rounds_played = 0
var rounds_won = 0
var new_best = false
if save.try_read(RECORD_PATH):
    best_place = save.get_int("best_place")
    best_kills = save.get_int("best_kills")
    rounds_played = save.get_int("rounds")
    rounds_won = save.get_int("wins")

function record_round():
    rounds_played += 1
    if won:
        rounds_won += 1
    new_best = best_place == 0 or placement < best_place
    if new_best:
        best_place = placement
    best_kills = math.max(best_kills, me.kills)
    save.int("best_place", best_place)
    save.int("best_kills", best_kills)
    save.int("rounds", rounds_played)
    save.int("wins", rounds_won)
    save.write(RECORD_PATH)

# ---------------------------------------------------------------
# The island.
# ---------------------------------------------------------------
spawn world.Sea
spawn world.Beach
spawn world.Ground
# The ground you stand on (the plateau and the beach, as one slab).
physics.static_box(vec3(0, -1.0, 0), vec3(tuning.BEACH_HALF * 2, 2.0, tuning.BEACH_HALF * 2))

for b in world.BLOCKS:
    let block = spawn world.Block at vec3(b[1], b[6] + b[5] / 2, b[2])
    block.size = vec3(b[3], b[5], b[4])
    block.kind = b[0]
    if b[0] == 4:
        block.shade = (0.95, 0.95, 1.0)
    else:
        physics.static_box(block.pos, block.size)

for l in world.LANTERNS:
    let post = spawn world.LanternPost at vec3(l[0], 0, l[1])
    post.turn = l[2]
    # The lamp hangs 0.65 m out along the post's arm, 2.2 m up: a light,
    # and a glowing pane so it reads as lit.
    let lamp = vec3(l[0] + math.cos(l[2]) * 0.65, 2.2, l[1] - math.sin(l[2]) * 0.65)
    light.add(lamp, (3.6, 2.0, 0.9, 1.0), 14.0)
    spawn world.LampGlow at lamp
    physics.static_box(vec3(l[0], 1.3, l[1]), vec3(0.3, 2.6, 0.3))

# The beacon atop the vault lights the yard violet.
light.add(vec3(0, 10.5, -2), (0.6, 0.35, 1.0, 1.0), 26.0)

# Trees, rocks and crates on clear ground.
var placed = 0
var tries = 0
while placed < 90 and tries < 2000:
    tries += 1
    let x = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 4)
    let z = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 4)
    if world.clear_ground(x, z, 3.0) and world.place_at(x, z) == "":
        let pick = random.float()
        if pick < 0.6:
            let t = spawn world.Tree at vec3(x, 0, z)
            t.turn = random.float() * 6.28
            t.size = 0.85 + random.float() * 0.5
            physics.static_box(vec3(x, 1.0, z), vec3(0.5, 2.0, 0.5))
        elif pick < 0.85:
            let r = spawn world.Rock at vec3(x, 0, z)
            r.turn = random.float() * 6.28
            r.size = 0.8 + random.float() * 0.9
            physics.static_box(vec3(x, 0.4, z), vec3(1.2 * r.size, 0.8 * r.size, 1.0 * r.size))
        else:
            let c = spawn world.Crate at vec3(x, 0, z)
            c.turn = random.float() * 1.57
            physics.static_box(vec3(x, 0.45, z), vec3(0.9, 0.9, 0.9))
        placed += 1

# Each place's props, and their candles' and mushrooms' light.
for d in world.DRESSING:
    let p = spawn world.Prop at vec3(d[1], 0, d[2])
    p.model = d[0]
    p.turn = d[3]
    p.shine = d[5]
    if d[4] > 0.0:
        physics.static_box(vec3(d[1], 0.6, d[2]), vec3(d[4] * 2, 1.2, d[4] * 2))
    if d[6] > 0.0:
        light.add(vec3(d[1], 0.6, d[2]), (d[5][0] * 0.8, d[5][1] * 0.8, d[5][2] * 0.8, 1.0), d[6])

# Night growth on clear ground: bushes, flowers, glowing mushrooms.
var grown = 0
var grow_tries = 0
while grown < 170 and grow_tries < 3000:
    grow_tries += 1
    let x = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 3)
    let z = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 3)
    if world.clear_ground(x, z, 1.0):
        var pick = random.float()
        for g in world.GROWTH:
            if pick >= 0.0:
                pick -= g[1]
                if pick < 0.0:
                    let p = spawn world.Prop at vec3(x, 0, z)
                    p.model = g[0]
                    p.turn = random.float() * 6.283
                    p.size = 0.8 + random.float() * 0.6
                    p.shine = g[2]
        grown += 1

# Keep the island's edge: invisible walls at the beach's rim.
let rim = tuning.BEACH_HALF
physics.static_box(vec3(0, 2, -rim), vec3(rim * 2, 4, 1))
physics.static_box(vec3(0, 2, rim), vec3(rim * 2, 4, 1))
physics.static_box(vec3(-rim, 2, 0), vec3(1, 4, rim * 2))
physics.static_box(vec3(rim, 2, 0), vec3(1, 4, rim * 2))

# ---------------------------------------------------------------
# The vault's gate, shut until the round's third minute.
# ---------------------------------------------------------------
let gate = spawn world.Block at vec3(0, 1.7, 11.0)
gate.size = vec3(5.0, 3.4, 0.5)
gate.kind = 2
gate.shade = (0.7, 0.75, 0.85)
let gate_body = physics.static_box(gate.pos, gate.size)
var gate_open = false

# ---------------------------------------------------------------
# The keeper, the camera, the round.
# ---------------------------------------------------------------
let me = spawn player.Player at vec3(0, 34, 0)
var cam_x = 0.0
var cam_z = 0.0
var cam_h = tuning.CAM_HEIGHT

let MODELS = ["assets/folk_moss.glb", "assets/folk_dusk.glb", "assets/folk_ember.glb", "assets/folk_tide.glb"]

var stage = "barge"               # barge → playing → over
var barge = nil
let hush = spawn round.Hush
var round_time = 0.0
var placement = 0
var won = false
var leader_kills = 0              # the most kills anyone has
var last_call = 99                # the last "N LEFT" banner shown

# Chests: a few in each place, the vault's richest, more in the wilds.
function place_chests():
    for p in world.PLACES:
        let tier = if p[4] >= 3: 3 else: 2
        var n = 0
        var tries = 0
        while n < tuning.CHESTS_PER_PLACE and tries < 300:
            tries += 1
            let a = random.float() * 6.283
            let r = random.float() * p[3] * 0.85
            let x = p[1] + math.cos(a) * r
            let z = p[2] + math.sin(a) * r
            if world.clear_ground(x, z, 1.2):
                let c = spawn loot.Chest at vec3(x, 0, z)
                c.tier = tier
                c.turn = random.float() * 6.283
                n += 1
    var w = 0
    var tries = 0
    while w < tuning.CHESTS_IN_WILDS and tries < 1500:
        tries += 1
        let x = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 6)
        let z = (random.float() * 2 - 1) * (tuning.ISLAND_HALF - 6)
        if world.clear_ground(x, z, 1.5) and world.place_at(x, z) == "":
            let c = spawn loot.Chest at vec3(x, 0, z)
            c.turn = random.float() * 6.283
            w += 1

# Clear the last round's people, loot and effects away.
function clear_round():
    for b in entities.of(bots.Bot):
        if b.body >= 0:
            physics.despawn(b.body)
        despawn b
    for c in entities.of(loot.Chest):
        despawn c
    for l in entities.of(loot.Loot):
        despawn l
    for f in entities.of(combat.Flash):
        if f.handle >= 0:
            light.remove(f.handle)
        despawn f
    for t in entities.of(combat.Tracer):
        despawn t
    for s in entities.of(combat.Shell):
        despawn s
    for s in entities.of(combat.Star):
        despawn s
    for r in entities.of(combat.Ring):
        despawn r
    for p in entities.of(combat.Popup):
        despawn p
    for d in entities.of(combat.Dummy):
        despawn d
    for b in entities.of(round.Barge):
        b.gone()
    for h in entities.of(loot.HeldGun):
        if h.owner != me:
            despawn h

# A new round: the barge sets out with everyone aboard.
function start_round():
    clear_round()
    place_chests()
    barge = round.launch_barge()
    # The keeper.
    if me.body >= 0:
        physics.despawn(me.body)
    me.body = -1
    me.phase = "aboard"
    me.barge = barge
    me.alive = true
    me.hp = 100.0
    me.shield = 0.0
    me.kills = 0
    me.damage = 0.0
    me.cells = 0
    me.guns = [0, -1, -1]
    me.rarity = [0, 0, 0]
    me.mag = [0, 0, 0]
    me.reserve = 0
    me.slot = 0
    me.star_cd = 0.0
    me.control = true
    me.pos = barge.pos
    # The rivals, aboard too, each with somewhere it means to land.
    for i in 0..<tuning.BOT_COUNT:
        let b = spawn bots.Bot at barge.pos
        b.barge = barge
        b.offset = vec3((random.float() - 0.5) * 2.4, 1.4, (random.float() - 0.5) * 8.0)
        b.target = bots.drop_target()
        b.model = MODELS[math.mod(i, 4)]
        b.name = names.handle()
        b.skill = 0.2 + random.float() * 0.7
        b.team = 10 + i
        let held = spawn loot.HeldGun at b.pos
        held.owner = b
        b.held = held
    # The Hush waits for everyone to land.
    hush.pos = vec3(0, 0, 0)
    hush.radius = 150.0
    hush.running = false
    bots.arena_center = vec3(0, 0, 0)
    bots.arena_radius = 100.0
    bots.sight_scale = 0.55
    combat.feed = []
    hud.banners = []
    stage = "barge"
    menu = ""
    pause(false)
    new_best = false
    round_time = 0.0
    time.set_scale(1.0)
    slow_t = 0.0
    placement = 0
    won = false
    leader_kills = 0
    last_call = 99
    close_gate()
    cam_x = barge.pos.x
    cam_z = barge.pos.z

function close_gate():
    if gate_open:
        gate_open = false
        gate.pos = vec3(0, 1.7, 11.0)

function open_gate():
    gate_open = true
    gate.pos = vec3(0, -20.0, 11.0)
    physics.despawn(gate_body)
    hud.banner("THE SIGNAL VAULT IS OPEN", (0.75, 0.55, 1.0))
    combat.flash(vec3(0, 3.0, 11.0), (2.0, 1.2, 3.0), 18.0, 0.8)

combat.keeper = me

# The keeper's own gun in hand, made once.
let my_gun = spawn loot.HeldGun at me.pos
my_gun.owner = me

# Seconds of slow motion left (the round's last moment).
var slow_t = 0.0

# ---------------------------------------------------------------
# The shell: the title, the pause menu, settings, the end of a round.
# ---------------------------------------------------------------
var menu = ""             # the menu up: "title", "pause", "settings", "over" or ""
var settings_from = ""    # the menu Settings was opened from
var title_t = 0.0

# The title: an empty island at night, the camera drifting round it.
function go_title():
    clear_round()
    pause(false)
    time.set_scale(1.0)
    slow_t = 0.0
    stage = "title"
    hush.running = false
    combat.feed = []
    hud.banners = []
    barge = nil
    if me.body >= 0:
        physics.despawn(me.body)
    me.body = -1
    me.barge = nil
    me.phase = "ground"
    me.alive = true
    me.control = false
    me.hp = 100.0
    me.shield = 0.0
    me.guns = [0, -1, -1]
    me.slot = 0
    me.vel = vec3(0, 0, 0)
    me.pos = vec3(0, 0, 20)
    me.heading = 0.0
    title_t = 0.0
    menu = "title"
    menus.open(menus.title_items(), 10)

function open_pause():
    menu = "pause"
    pause(true)
    menus.open(menus.PAUSE_ITEMS, 6)
    sounds.sfx(sounds.CLICK, 0.8)

function resume():
    menu = ""
    pause(false)
    me.calm = 0.3

function close_settings():
    settings.save(SETTINGS_PATH)
    menu = settings_from
    if menu == "pause":
        menus.open(menus.PAUSE_ITEMS, 4)
    else:
        menus.open(menus.title_items(), 4)
    menus.focus = 1

# What a menu choice does.
function act_on(act):
    if act == "play" or act == "again":
        start_round()
    elif act == "settings":
        settings_from = menu
        menu = "settings"
        menus.open(menus.settings_items(), 6)
    elif act == "back":
        close_settings()
    elif act == "resume":
        resume()
    elif act == "leave" or act == "title":
        go_title()
    elif act == "quit":
        quit()
    elif act == "changed":
        apply_settings()

# One tick of the shell — run by the Shell entity, so it still runs
# while the world is paused under a menu.
function shell_step():
    sounds.listener = me.pos
    var esc = key_press.escape or gamepad_press.start
    let in_round = stage == "barge" or stage == "playing"
    if menu == "settings":
        if esc and menus.listening < 0:
            close_settings()
            esc = false
    elif menu == "pause":
        if esc:
            resume()
            esc = false
    elif menu == "" and in_round and (esc or is_paused()):
        # Esc, or the window losing focus (auto_pause_on_blur).
        open_pause()
    # A menu over a round keeps the world still, even when the window's
    # focus coming back lifts the pause the blur set.
    if (menu == "pause" or (menu == "settings" and settings_from == "pause")) and not is_paused():
        pause(true)
    if menu != "":
        let act = menus.step()
        if act != "":
            act_on(act)
    if menu == "over" and key_press.r and menus.hold <= 0:
        act_on("again")
    score_music()

# Calm under the night; tension as the Hush closes, the field thins or
# a fight starts; quieter under a menu.
function score_music():
    var calm = 1.0
    var tension = 0.0
    if stage == "playing":
        tension = math.clamp(0.22 * hush.phase, 0.0, 1.0)
        if alive_count() <= 5:
            tension = 1.0
        if combat.time_now() - me.fought_at < 5.0:
            tension = math.max(tension, 0.7)
        calm = 1.0 - 0.55 * tension
    elif stage == "over":
        calm = 0.5
    if menu == "pause" or (menu == "settings" and settings_from == "pause"):
        calm = calm * 0.5
        tension = tension * 0.4
    sounds.score(calm, tension)

entity Shell:
    initial: running

    state running:
        persistent

    function update(dt):
        shell_step()

spawn Shell
go_title()

# Everyone still standing, the keeper included.
function alive_count():
    var n = 0
    for b in entities.of(bots.Bot):
        if b.alive:
            n += 1
    if me.alive:
        n += 1
    return n

function anyone_aboard():
    if me.phase != "ground":
        return true
    for b in entities.of(bots.Bot):
        if b.phase != "ground":
            return true
    return false

# Fireflies keep rising around wherever the keeper is.
var firefly_t = 0.0

on update(dt):
    mesh_anim.advance(dt)
    firefly_t -= dt
    if firefly_t <= 0.0:
        firefly_t = 3.0
        let a = random.float() * 6.283
        spawn world.Fireflies at vec3(me.pos.x + math.cos(a) * 8.0, 0, me.pos.z + math.sin(a) * 8.0)
    # Everyone who can be hurt this tick (see combat.twe).
    var everyone = [a for a in entities.of(bots.Bot)]
    for d in entities.of(combat.Dummy):
        everyone.append(d)
    everyone.append(me)
    combat.actors = everyone
    if stage == "barge":
        if barge != nil and barge.time_left() < -6.0:
            barge.gone()
            barge = nil
        if not anyone_aboard():
            stage = "playing"
            hush.start()
            hud.banner("THE HUSH STIRS", (0.75, 0.55, 1.0))
    if stage == "playing":
        round_time += dt
        bots.arena_center = hush.next_center
        bots.arena_radius = math.max(8.0, hush.next_radius)
        bots.sight_scale = math.min(1.0, 0.55 + 0.15 * math.max(0, hush.phase))
        if not gate_open and round_time >= tuning.VAULT_OPENS:
            open_gate()
        watch_the_round()
    # The keeper's heart, when it's nearly out.
    if stage == "playing" and me.alive and me.hp < 35.0:
        heartbeat_t -= dt
        if heartbeat_t <= 0.0:
            heartbeat_t = 0.55 + me.hp / 35.0 * 0.45
            sounds.sfx(sounds.HEARTBEAT, 0.7)
    # Slow motion fades back to speed in real seconds.
    if slow_t > 0.0:
        slow_t -= dt / time.scale
        if slow_t <= 0.0:
            time.set_scale(1.0)
    mood()
    if stage == "title":
        title_camera(dt)
    else:
        follow_camera(dt)

var heartbeat_t = 0.0

# Round and round the island, slowly, over the vault.
function title_camera(dt):
    title_t += dt
    let a = 0.6 + title_t * 0.04
    camera.target = vec3(0, 2.0, 4.0)
    camera.eye = vec3(math.sin(a) * 46.0, 26.0, 4.0 + math.cos(a) * 46.0)

# The screen's edge: red and pulsing when hurt, violet in the Hush.
function mood():
    var strength = 0.32
    var tint = (0.02, 0.02, 0.08)
    if me.alive and me.phase == "ground":
        if me.hp < 35.0:
            let pulse = 0.5 + 0.5 * math.sin(combat.time_now() * 7.0)
            strength = 0.5 + 0.25 * pulse * (1.0 - me.hp / 35.0)
            tint = (0.5, 0.03, 0.04)
        elif hush.running and hush.outside(me.pos):
            strength = 0.55
            tint = (0.3, 0.08, 0.5)
    postfx.vignette(strength)
    postfx.vignette_color(tint)

# Banners for the moments that matter, and the end of the round.
function watch_the_round():
    let alive = alive_count()
    if me.kills > leader_kills and me.kills >= 2:
        hud.banner("NEW KILL LEADER", (1.0, 0.78, 0.4))
    for b in entities.of(bots.Bot):
        leader_kills = math.max(leader_kills, b.kills)
    leader_kills = math.max(leader_kills, me.kills)
    for n in [10, 5, 3, 2]:
        if alive <= n and last_call > n and me.alive:
            last_call = n
            hud.banner("{n} LEFT", (1.0, 1.0, 1.0))
    if not me.alive:
        stage = "over"
        placement = alive + 1
        me.control = false
        time.set_scale(0.35)
        slow_t = 1.4
        sounds.sfx(sounds.DEFEAT, 0.9)
        end_round()
    elif alive == 1:
        stage = "over"
        won = true
        placement = 1
        me.control = false
        mesh_anim.play(me, "victory", true)
        fx.hit_stop(0.2)
        time.set_scale(0.3)
        slow_t = 1.8
        sounds.sfx(sounds.VICTORY, 0.9)
        end_round()

function end_round():
    record_round()
    menu = "over"
    menus.open(menus.OVER_ITEMS, 45)

function follow_camera(dt):
    # High above while aboard, lower while gliding, so you can pick
    # where to land and watch the ground come up.
    var want_h = tuning.CAM_HEIGHT
    if me.phase == "aboard":
        want_h = tuning.CAM_HEIGHT * 3.2
    elif me.phase == "glide":
        want_h = tuning.CAM_HEIGHT + me.pos.y * 1.3
    cam_h = cam_h + (want_h - cam_h) * math.min(1.0, dt * 1.5)
    # Follow the keeper, leaning toward the cursor so you see where you
    # aim — but never so far that the keeper leaves the screen.
    var lean_x = 0.0
    var lean_z = 0.0
    if me.phase == "ground":
        lean_x = (me.aim.x - me.pos.x) * tuning.CAM_LEAD
        lean_z = (me.aim.z - me.pos.z) * tuning.CAM_LEAD
        let lean = math.sqrt(lean_x * lean_x + lean_z * lean_z)
        if lean > tuning.CAM_LEAN_MAX:
            lean_x = lean_x * tuning.CAM_LEAN_MAX / lean
            lean_z = lean_z * tuning.CAM_LEAN_MAX / lean
    let want_x = me.pos.x + lean_x
    let want_z = me.pos.z + lean_z
    let k = math.min(1.0, dt * tuning.CAM_SMOOTH)
    cam_x = cam_x + (want_x - cam_x) * k
    cam_z = cam_z + (want_z - cam_z) * k
    # Recoil nudges the view back along the aim.
    let kx = -math.sin(me.heading) * me.kick * 0.12
    let kz = -math.cos(me.heading) * me.kick * 0.12
    let ground_y = if me.phase == "ground": 0.6 else: 0.0
    camera.target = vec3(cam_x + kx, ground_y, cam_z + kz)
    camera.eye = vec3(cam_x + kx, ground_y + cam_h, cam_z + kz + cam_h * tuning.CAM_BACK / tuning.CAM_HEIGHT)

on render():
    if stage == "title":
        if menu == "settings":
            menus.draw_settings()
        else:
            menus.draw_title(best_place, best_kills, rounds_played, rounds_won, combat.time_now())
    else:
        draw_round()
        if menu == "pause":
            menus.draw_pause()
        elif menu == "settings":
            menus.draw_settings()

function draw_round():
    if stage != "barge" or me.phase == "ground":
        hud.draw_tags(entities.of(bots.Bot), me)
    hud.draw_popups(entities.of(combat.Popup))
    if stage == "over" or menu != "":
        # A menu or the results take the screen: no crosshair, prompts,
        # loadout or banners.
        hud.draw_match(alive_count(), me.kills, combat.feed, combat.time_now())
        hud.draw_map(me, hush, barge, world.PLACES)
    else:
        if me.phase == "aboard":
            hud.draw_aboard(barge, world.place_at(me.pos.x, me.pos.z))
        elif me.phase == "glide":
            hud.draw_glide(me, world.place_at(me.pos.x, me.pos.z))
        else:
            hud.draw_playing(me, world.place_at(me.pos.x, me.pos.z))
        hud.draw_match(alive_count(), me.kills, combat.feed, combat.time_now())
        hud.draw_hush(hush, me, stage)
        hud.draw_map(me, hush, barge, world.PLACES)
        hud.draw_banners(combat.time_now())
    if stage == "over":
        hud.draw_results(won, placement, me.kills, me.damage, round_time, best_place, new_best)
        if menu == "over":
            menus.draw_over()
