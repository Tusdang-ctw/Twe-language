# @task: Lanternfall tuning module
# @inputs: none
# @expected: every tunable number of the battle royale, as constants
# @category: 3d
# @difficulty: trivial
#
# Lanternfall — every tunable number in one place.
#
# Modules hold constants, classes and functions; the main file owns the
# world (see main.twe). Read these as `tuning.NAME`.

# --- the island ---
let ISLAND_HALF = 110.0          # the grass plateau spans ±ISLAND_HALF metres
let BEACH_HALF = 122.0           # the sand ring around it
let SEA_LEVEL = -0.45

# --- the player ---
let WALK_SPEED = 5.5             # m/s
let ACCEL = 38.0                 # how fast the keeper reaches walking speed
let FRICTION = 30.0              # how fast it stops when you let go
let DODGE_SPEED = 15.0           # m/s during a roll
let DODGE_TIME = 0.26            # seconds of roll (invulnerable)
let DODGE_COOLDOWN = 1.6
let GRAVITY = 22.0               # m/s² (a little heavy: snappy landings)
let BODY_HEIGHT = 1.6            # the character capsule
let BODY_RADIUS = 0.34
let AIM_HEIGHT = 1.0             # the cursor aims at this height above the ground

# --- the camera ---
let CAM_FOV = 44.0               # degrees
let CAM_HEIGHT = 24.0
let CAM_BACK = 9.0
let CAM_SMOOTH = 7.0             # higher = tighter follow
let CAM_LEAD = 0.22              # how far the camera leans toward the cursor (0..1)
let CAM_LEAN_MAX = 4.5           # metres, at most

# --- combat ---
let STAR_COOLDOWN = 18.0         # seconds between Starcalls
let CELL_TIME = 2.5              # seconds to channel a shield cell
let CELL_SHIELD = 25             # shield one cell gives

# --- the bots ---
let BOT_COUNT = 31               # rivals; with the keeper, 32 on the island
let BOT_SIGHT = 26.0             # metres they can see in the dark
