# @task: glTF mesh import demo
# @inputs: none
# @expected: load + render a .glb file in the 3D scene
# @category: 3d
# @difficulty: trivial
#
# v0.2 session 1 — `.glb` mesh import.
#
# Loads `examples/assets/triangle.glb` (a minimal three-vertex
# triangle generated by the `write_triangle_glb_fixture` test in
# `src/play3d.rs::tests`) and queues it alongside cubes and a
# central sphere. Drop your own `.glb` next to this file and
# change the path to see arbitrary meshes render.
#
# Run with:
#   twec play3d examples/hello_glb.twe
#
# If the path is wrong or the file isn't a valid glTF binary,
# the loader prints one error to stderr and the draw silently
# no-ops on subsequent frames — the rest of the scene keeps
# rendering. Hot reload picks up edits to either this file or
# the `.glb` itself.

let cam_distance = 4.0
var orbit = 0.0
var spin_speed = 0.6

on update(dt):
    orbit = orbit + spin_speed * dt
    camera.eye = vec3(
        cam_distance * math.sin(orbit),
        1.5,
        cam_distance * math.cos(orbit),
    )
    camera.target = vec3(0, 0, 0)

on render():
    # Reference cube + sphere to anchor the scene.
    cube(at: vec3(-1.5, 0, 0), color: color.green, size: 0.5)
    sphere(at: vec3(1.5, 0, 0), color: color.purple, size: 0.5)
    # The imported triangle. Two copies — one tinted, one
    # smaller — to show that one `.glb` can drive multiple
    # instances (per-mesh instanced draw call under the hood).
    mesh("examples/assets/triangle.glb",
        at: vec3(0, 0.3, 0), color: color.red, size: 1.0)
    mesh("examples/assets/triangle.glb",
        at: vec3(0, -0.6, 0), color: color.yellow, size: 0.6)
