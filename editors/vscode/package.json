{
  "name": "twe-language",
  "displayName": "Twe Language",
  "description": "A game-first scripting language with state machines, scenes, dialogue, and a wgpu 3D runtime. Editor side: syntax, diagnostics, hover types, go-to-definition, completion.",
  "version": "0.1.1",
  "publisher": "twena-inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tusdang-ctw/Twe-language"
  },
  "homepage": "https://github.com/Tusdang-ctw/Twe-language",
  "bugs": {
    "url": "https://github.com/Tusdang-ctw/Twe-language/issues"
  },
  "keywords": [
    "twe",
    "game",
    "scripting",
    "language",
    "gamedev",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "icon": "icon.png",
  "contributes": {
    "languages": [
      {
        "id": "twe",
        "aliases": ["Twe", "twe"],
        "extensions": [".twe"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "twe",
        "scopeName": "source.twe",
        "path": "./syntaxes/twe.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Twe",
      "properties": {
        "twe.serverPath": {
          "type": "string",
          "default": "twec",
          "description": "Path to the `twec` binary. Defaults to looking it up on PATH; set to an absolute path if you've built locally."
        },
        "twe.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VS Code and the Twe LSP server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0"
  }
}
