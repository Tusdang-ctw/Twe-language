# @task: Full Vampire-Survivors clone with waves, XP, level-up, weapons, boss
# @inputs: arrow keys / WASD / gamepad
# @expected: 1300-line beta game running at 60fps; pause + settings + save
# @category: 2d
# @difficulty: large
#
# Phase 14 — Survive Beta (Vampire-Survivors clone).
#
# Run with:  twec play examples/survive_beta/main.twe
# Build to a redistributable .exe with:
#   twec build examples/survive_beta
#
# v0.5 examples/survive.twe was the Phase-2 single-file vertical
# slice — bullets, one monster type, arrow-key movement. This is
# the production beta: arena map, camera follow, wave-based enemy
# AI, auto-attack weapons, XP + level-up + upgrade choices, gamepad
# support, the full Phase-10 settings/pause stack.
#
# Sessions land outside-in: session 1 ships scaffold + movement +
# camera + arena (this commit). Slime AI, waves, auto-attack, XP,
# level-up, more weapons / enemies, boss, polish, build-pipeline
# integration follow.

settings.set_default("keys.right", "right")
settings.set_default("keys.right_alt", "d")
settings.set_default("keys.left", "left")
settings.set_default("keys.left_alt", "a")
settings.set_default("keys.up", "up")
settings.set_default("keys.up_alt", "w")
settings.set_default("keys.down", "down")
settings.set_default("keys.down_alt", "s")
settings.try_load("examples/survive_beta/survive_beta.save")

# World-space coordinates. The arena is `arena_w × arena_h` units
# wide; the player roams freely inside it. Viewport is 640×480 so
# the camera tracks the player and stays inside the arena's edges
# (no camera shake outside the world bounds — we clamp the camera
# rather than the player so the world-edge feels tangible).
let arena_w = 2400.0
let arena_h = 1800.0
let view_w = 640.0
let view_h = 480.0

var player_x = 1200.0
var player_y = 900.0
var player_speed = 220.0
var player_hp = 100.0
var player_max_hp = 100.0
# Brief invulnerability after a hit so a single slime overlap
# doesn't drain the bar in one frame. Refreshed on every successful
# damage event.
var player_iframes = 0.0
var kills = 0
# XP system. Each slime that dies spawns one XPGem worth 1 point.
# The gem flies toward the player when within `magnetic_radius` and
# is collected on overlap. Session 6 reads `xp` against
# `xp_to_next_level` to trigger the level-up modal.
var xp = 0
var xp_to_next_level = 5
var magnetic_radius = 100.0
# Auto-attack pacing. v1 fires one bolt every 0.6s — session 6's
# upgrade picker mutates `attack_interval` (and player_speed,
# magnetic_radius, player_max_hp). Hoisted to a global so the
# top-level `apply_upgrade` helper can write it; scene fields
# aren't reachable from a free function.
var attack_interval = 0.6
# Level-up modal state. `in_levelup` gates Slime / Projectile /
# XPGem updates so the world freezes while the picker is open.
# `level` is the player's level (display-only); `pick_a/b/c` are
# the three rolled upgrade IDs the picker shows.
var level = 1
var in_levelup = false
var pick_a = 0
var pick_b = 1
var pick_c = 2
# Monotonic time for time-driven weapons (Blade orbit angle).
# Advanced from the playing-state every-clock; entities read it
# rather than maintaining their own per-instance accumulator
# (a global accumulator keeps multi-blade orbits in lockstep).
var weapon_time = 0.0
# Best-wave / best-time tracker across game-overs in this session.
# Persists for the process lifetime; saving across launches would
# need `settings.save("examples/survive_beta/survive_beta.save")`
# in the death handler — kept lightweight in v1.
var best_wave = 1
var best_time = 0.0
# Boss spawn cadence. Counts up every wave roll; on hitting 5,
# spawns one boss and resets. Wave 5 is the first boss wave.
var boss_wave_counter = 0
# v1.0.1 polish: hit feedback flows through `fx.*` (hit_flash +
# screen_shake + damage_number); camera tracking flows through
# `camera2d.*`; save schema versioning via `save.*`. Audio remains
# deferred — `sound.pool` pre-declares the voice budget so the
# slime-hit / boss-roar SFX clip-stack cleanly when wired.
sound.pool("examples/assets/silence.wav", 4)
save.set_schema_version(1)
camera2d.bounds(view_w * 0.5, view_h * 0.5, arena_w - view_w, arena_h - view_h)
var camera_x = player_x - view_w * 0.5
var camera_y = player_y - view_h * 0.5


# ---------------------------------------------------------------
# Upgrade pool. `pick_a/b/c` index into this 5-entry catalogue.
# `upgrade_name` returns the picker label; `apply_upgrade` mutates
# the relevant globals. Both are top-level functions so the
# scene's level_up state can call them — scene fields aren't
# reachable from free functions, which is why `attack_interval`
# / `magnetic_radius` / `player_speed` / `player_max_hp` all live
# at file scope.
# ---------------------------------------------------------------

# Every enemy's contact-damage path funnels through this one
# function so `fx.*` feedback (hit_flash + screen_shake +
# damage_number) stays consistent across enemy classes.
function take_player_damage(amount):
    player_hp -= amount
    player_iframes = 0.6
    let sx = player_x - camera_x
    let sy = player_y - camera_y
    fx.hit_flash(at: (sx - 12.0, sy - 12.0), size: (24.0, 24.0), color: color.red, duration: 0.12)
    fx.screen_shake(amount: 4.0, duration: 0.12)
    fx.damage_number(at: (sx, sy - 24.0), value: amount, color: color.white)

function upgrade_name(id):
    if id == 0:
        return "Faster Attack  (-15% cooldown)"
    elif id == 1:
        return "Wider Magnet   (+30 range)"
    elif id == 2:
        return "Tougher Hide   (+20 max HP)"
    elif id == 3:
        return "Swift Feet     (+30 move speed)"
    elif id == 4:
        return "Quick Heal     (full HP)"
    elif id == 5:
        return "Orbiting Blade (+1 blade)"
    return "Damaging Aura  (faster ticks / new aura)"

function apply_upgrade(id):
    if id == 0:
        attack_interval *= 0.85
        if attack_interval < 0.1:
            attack_interval = 0.1
    elif id == 1:
        magnetic_radius += 30.0
    elif id == 2:
        player_max_hp += 20.0
        player_hp += 20.0
    elif id == 3:
        player_speed += 30.0
    elif id == 4:
        player_hp = player_max_hp
    elif id == 5:
        # Orbiting Blade — spawn one more blade and redistribute
        # phases evenly around the orbit.
        spawn Blade at (player_x, player_y)
        var count = 0
        for b in entities.of(Blade):
            count += 1
        var i = 0
        let two_pi = 6.28318530717958647692
        for b in entities.of(Blade):
            b.phase = i * two_pi / count
            i += 1
    else:
        # Damaging Aura — spawn if absent, otherwise tighten its
        # tick interval. Aura position is irrelevant (it tracks
        # the player every frame); the spawn `at` is just to
        # satisfy the syntax.
        var has_aura = false
        for a in entities.of(Aura):
            has_aura = true
            a.tick_interval *= 0.85
            if a.tick_interval < 0.1:
                a.tick_interval = 0.1
        if not has_aura:
            spawn Aura at (player_x, player_y)


# ---------------------------------------------------------------
# Slime — the opening enemy. Constant chase AI, deals contact
# damage on overlap. Declared before the scene so the scene's
# state-entry body can `spawn Slime` — top-level statements run
# in source order and a forward reference would error with
# "class 'Slime' is not defined".
# ---------------------------------------------------------------
entity Slime:
    var pos = (0.0, 0.0)
    var speed = 70.0
    var hp = 1
    var damage = 8.0

    function update(dt):
        # Soft-pause during level-up modal. Engine-level pause()
        # would also stop the level_up state's input handlers
        # (every-clocks halt); the in_levelup flag freezes only
        # entity ticks while keeping the modal interactive.
        if in_levelup:
            return
        # Chase the player. Same vector-toward-target shape as
        # survive.twe's Monster, lifted into a per-class field so
        # session 8's bat / skeleton can override `speed` /
        # `damage` without rewriting the AI body.
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let mag2 = dx * dx + dy * dy
        if mag2 < 1.0:
            return
        let mag = math.sqrt(mag2)
        pos = (pos.x + dx / mag * speed * dt, pos.y + dy / mag * speed * dt)

        # Contact damage. Single-step overlap test against a 22px
        # collision radius (player half-extent 12 + slime
        # half-extent 10). I-frames gate damage at 0.6s so a slime
        # that sticks to the player drains at a survivable rate.
        let r = 22.0
        if dx * dx + dy * dy < r * r:
            if player_iframes <= 0.0:
                take_player_damage(damage)

    function render():
        if in_levelup:
            return
        # Slime sprites stub: a 20×20 cyan square. Session 10's
        # polish pass swaps in a real PNG once the asset's drawn.
        rect(
            at: (pos.x - camera_x - 10, pos.y - camera_y - 10),
            size: (20, 20),
            color: color.cyan
        )


# ---------------------------------------------------------------
# Bat — fast, weaving flier. 130 u/s straight-line approach plus
# a perpendicular sin-wave offset so it doesn't read as "another
# slime, but cyan." 1 HP, 5 damage on contact. Spawns from
# wave 2 onward.
# ---------------------------------------------------------------
entity Bat:
    var pos = (0.0, 0.0)
    var hp = 1
    var damage = 5.0
    var weave_phase = 0.0

    function update(dt):
        if in_levelup:
            return
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let mag2 = dx * dx + dy * dy
        if mag2 < 1.0:
            return
        let mag = math.sqrt(mag2)
        let nx = dx / mag
        let ny = dy / mag
        # Perpendicular weave: rotate (nx, ny) by 90° to (-ny, nx),
        # multiply by sin-wave amplitude. Phase advances at 5 rad/s.
        weave_phase += dt * 5.0
        let weave = math.sin(weave_phase) * 30.0
        let speed = 130.0
        pos = (
            pos.x + nx * speed * dt + (-ny) * weave * dt,
            pos.y + ny * speed * dt + nx * weave * dt,
        )
        # Contact damage. Same 22px radius + 0.6s i-frames as Slime.
        if mag2 < 22.0 * 22.0:
            if player_iframes <= 0.0:
                take_player_damage(damage)

    function render():
        if in_levelup:
            return
        rect(
            at: (pos.x - camera_x - 8, pos.y - camera_y - 8),
            size: (16, 16),
            color: color.purple,
        )


# ---------------------------------------------------------------
# Skeleton — slow ranged attacker. Approaches to a 250px standoff
# distance, then sits and fires SkeletonBolts at the player every
# 1.5s. 1 HP. The fire-and-stand pattern means players can no
# longer purely kite on the perimeter — they have to weave through
# bolts. Spawns from wave 4 onward.
# ---------------------------------------------------------------
entity Skeleton:
    var pos = (0.0, 0.0)
    var hp = 1
    var fire_timer = 0.0
    var fire_interval = 1.5
    var standoff = 250.0
    var move_speed = 50.0

    function update(dt):
        if in_levelup:
            return
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let d2 = dx * dx + dy * dy
        if d2 > standoff * standoff:
            let mag = math.sqrt(d2)
            pos = (
                pos.x + dx / mag * move_speed * dt,
                pos.y + dy / mag * move_speed * dt,
            )
        fire_timer += dt
        if fire_timer >= fire_interval:
            fire_timer = 0.0
            spawn SkeletonBolt at pos

    function render():
        if in_levelup:
            return
        rect(
            at: (pos.x - camera_x - 10, pos.y - camera_y - 14),
            size: (20, 28),
            color: color.white,
        )


# ---------------------------------------------------------------
# SkeletonBolt — enemy projectile. Locks onto the player's
# position at spawn-frame, then flies straight at 280 u/s. 12
# damage on contact + i-frames.
# ---------------------------------------------------------------
entity SkeletonBolt:
    var pos = (0.0, 0.0)
    var vx = 0.0
    var vy = 0.0
    var target_set = false
    var lifetime = 3.0

    function update(dt):
        if in_levelup:
            return
        if not target_set:
            target_set = true
            let dx = player_x - pos.x
            let dy = player_y - pos.y
            let mag = math.sqrt(dx * dx + dy * dy)
            if mag > 1.0:
                vx = dx / mag * 280.0
                vy = dy / mag * 280.0
        pos = (pos.x + vx * dt, pos.y + vy * dt)
        lifetime -= dt
        if lifetime <= 0.0:
            despawn self
            return
        let dx2 = player_x - pos.x
        let dy2 = player_y - pos.y
        if dx2 * dx2 + dy2 * dy2 < 18.0 * 18.0:
            if player_iframes <= 0.0:
                take_player_damage(12)
            despawn self

    function render():
        if in_levelup:
            return
        rect(
            at: (pos.x - camera_x - 3, pos.y - camera_y - 3),
            size: (6, 6),
            color: color.red,
        )


# ---------------------------------------------------------------
# Boss — periodic high-HP enemy. First boss spawns when the
# wave_index rolls to a multiple of 5 (wave 5 = first boss wave).
# Unlike other enemies, the boss has multi-hit HP — weapons
# subtract from `hp` rather than 1-shot-despawn. Renders an HP
# bar above its head while alive. Drops 10 XP gems on death.
# ---------------------------------------------------------------
entity Boss:
    var pos = (0.0, 0.0)
    var hp = 50.0
    var max_hp = 50.0
    var damage = 20.0
    var move_speed = 40.0

    function update(dt):
        if in_levelup:
            return
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let mag2 = dx * dx + dy * dy
        if mag2 < 1.0:
            return
        let mag = math.sqrt(mag2)
        pos = (
            pos.x + dx / mag * move_speed * dt,
            pos.y + dy / mag * move_speed * dt,
        )
        # 36px hit radius (boss half-extent 24 + player half 12).
        if mag2 < 36.0 * 36.0:
            if player_iframes <= 0.0:
                take_player_damage(damage)
                # Boss hits land harder — extra shake on top of the
                # shared take_player_damage feedback.
                fx.screen_shake(amount: 8.0, duration: 0.25)

    function render():
        if in_levelup:
            return
        # 48×48 orange body — bigger and warmer than the normal
        # enemy palette so it's instantly readable as a threat.
        rect(
            at: (pos.x - camera_x - 24, pos.y - camera_y - 24),
            size: (48, 48),
            color: color.orange,
        )
        # HP bar above the boss. 48px wide, scaled to current HP.
        rect(
            at: (pos.x - camera_x - 24, pos.y - camera_y - 36),
            size: (48, 4),
            color: color.gray,
        )
        let bar_w = 48.0 * (hp / max_hp)
        rect(
            at: (pos.x - camera_x - 24, pos.y - camera_y - 36),
            size: (bar_w, 4),
            color: color.red,
        )


# ---------------------------------------------------------------
# Projectile — the auto-attack weapon. Spawns at the player,
# self-targets the nearest slime on its first update tick, and
# travels in a straight line. The target-on-spawn-frame pattern
# avoids the "homing" feel of a per-frame retarget — once a
# bolt is in flight it commits, which preserves player skill
# expression (positioning matters).
# ---------------------------------------------------------------
entity Projectile:
    var pos = (0.0, 0.0)
    var vx = 0.0
    var vy = 0.0
    var target_set = false
    var lifetime = 1.5

    function update(dt):
        if in_levelup:
            return
        if not target_set:
            target_set = true
            var found = false
            var best_dx = 0.0
            var best_dy = 0.0
            var best_d2 = 0.0
            # Scan all enemy classes for the nearest target.
            for slime in entities.of(Slime):
                let dx = slime.pos.x - pos.x
                let dy = slime.pos.y - pos.y
                let d2 = dx * dx + dy * dy
                if not found or d2 < best_d2:
                    found = true
                    best_d2 = d2
                    best_dx = dx
                    best_dy = dy
            for bat in entities.of(Bat):
                let dx = bat.pos.x - pos.x
                let dy = bat.pos.y - pos.y
                let d2 = dx * dx + dy * dy
                if not found or d2 < best_d2:
                    found = true
                    best_d2 = d2
                    best_dx = dx
                    best_dy = dy
            for sk in entities.of(Skeleton):
                let dx = sk.pos.x - pos.x
                let dy = sk.pos.y - pos.y
                let d2 = dx * dx + dy * dy
                if not found or d2 < best_d2:
                    found = true
                    best_d2 = d2
                    best_dx = dx
                    best_dy = dy
            for boss in entities.of(Boss):
                let dx = boss.pos.x - pos.x
                let dy = boss.pos.y - pos.y
                let d2 = dx * dx + dy * dy
                if not found or d2 < best_d2:
                    found = true
                    best_d2 = d2
                    best_dx = dx
                    best_dy = dy
            if found:
                let mag = math.sqrt(best_d2)
                vx = best_dx / mag * 600.0
                vy = best_dy / mag * 600.0
            else:
                # No targets alive — drift upward and expire.
                vy = -600.0

        pos = (pos.x + vx * dt, pos.y + vy * dt)
        lifetime -= dt
        if lifetime <= 0.0:
            despawn self
            return

        # Hit check. 14px overlap radius — generous enough that
        # 600 u/s × 16ms ≈ 10u per frame doesn't tunnel through.
        # The check spans every enemy class; first overlap wins.
        for slime in entities.of(Slime):
            let dx = slime.pos.x - pos.x
            let dy = slime.pos.y - pos.y
            if dx * dx + dy * dy < 14.0 * 14.0:
                despawn slime
                despawn self
                kills += 1
                return
        for bat in entities.of(Bat):
            let dx = bat.pos.x - pos.x
            let dy = bat.pos.y - pos.y
            if dx * dx + dy * dy < 14.0 * 14.0:
                despawn bat
                despawn self
                kills += 1
                return
        for sk in entities.of(Skeleton):
            let dx = sk.pos.x - pos.x
            let dy = sk.pos.y - pos.y
            if dx * dx + dy * dy < 14.0 * 14.0:
                despawn sk
                despawn self
                kills += 1
                return
        # Boss collision uses a larger combined radius (boss
        # half-extent 24 + projectile half ~3 + slack ~5 ≈ 32).
        # Subtracts 5 damage; the boss only despawns when HP hits 0.
        for boss in entities.of(Boss):
            let dx = boss.pos.x - pos.x
            let dy = boss.pos.y - pos.y
            if dx * dx + dy * dy < 32.0 * 32.0:
                boss.hp -= 5.0
                if boss.hp <= 0.0:
                    despawn boss
                    kills += 1
                despawn self
                return

    function render():
        if in_levelup:
            return
        rect(
            at: (pos.x - camera_x - 3, pos.y - camera_y - 3),
            size: (6, 6),
            color: color.yellow
        )


# ---------------------------------------------------------------
# Blade — orbiting weapon. Each Blade reads `weapon_time` (a
# global accumulator advanced from the playing every-clock) and
# its own `phase` field; pos = player + (cos, sin) * radius.
# Spawning N blades and redistributing phases at upgrade-time
# keeps them evenly-spaced around the player. Touching a slime
# despawns it (no per-blade cooldown — Vampire-Survivors blades
# clear waves).
# ---------------------------------------------------------------
entity Blade:
    var phase = 0.0
    var pos = (0.0, 0.0)
    var orbit_radius = 60.0
    var orbit_speed = 3.0

    function update(dt):
        if in_levelup:
            return
        let angle = weapon_time * orbit_speed + phase
        pos = (
            player_x + math.cos(angle) * orbit_radius,
            player_y + math.sin(angle) * orbit_radius,
        )
        # 18px hit radius (blade half-extent 6 + ~12 enemy half-
        # extent ≈ 18). Sweeps every enemy class within range —
        # one frame can clip multiple targets at once which is
        # the load-bearing feel for a melee orbit.
        for slime in entities.of(Slime):
            let dx = slime.pos.x - pos.x
            let dy = slime.pos.y - pos.y
            if dx * dx + dy * dy < 18.0 * 18.0:
                despawn slime
                kills += 1
        for bat in entities.of(Bat):
            let dx = bat.pos.x - pos.x
            let dy = bat.pos.y - pos.y
            if dx * dx + dy * dy < 18.0 * 18.0:
                despawn bat
                kills += 1
        for sk in entities.of(Skeleton):
            let dx = sk.pos.x - pos.x
            let dy = sk.pos.y - pos.y
            if dx * dx + dy * dy < 18.0 * 18.0:
                despawn sk
                kills += 1
        # Boss takes 2 dmg per overlap-frame. With the blade
        # sweeping the boss for ~10-15 frames per orbit, that's
        # 20-30 dmg per pass — a 4-blade build clears a 50hp boss
        # in two orbits. Tunable in session 14 if it lands too
        # generous in playtest.
        for boss in entities.of(Boss):
            let dx = boss.pos.x - pos.x
            let dy = boss.pos.y - pos.y
            if dx * dx + dy * dy < 32.0 * 32.0:
                boss.hp -= 2.0
                if boss.hp <= 0.0:
                    despawn boss
                    kills += 1

    function render():
        if in_levelup:
            return
        rect(
            at: (pos.x - camera_x - 6, pos.y - camera_y - 6),
            size: (12, 12),
            color: color.white,
        )


# ---------------------------------------------------------------
# Aura — stationary-relative-to-player area weapon. On every
# `tick_interval` seconds, despawns every slime within `radius`.
# The genre-canonical "garlic" pattern: low-skill but always-on
# damage that rewards staying in the swarm. v1 ships one Aura
# per pick (subsequent picks tighten its tick).
# ---------------------------------------------------------------
entity Aura:
    var tick_timer = 0.0
    var tick_interval = 0.5
    var radius = 90.0

    function update(dt):
        if in_levelup:
            return
        tick_timer += dt
        if tick_timer >= tick_interval:
            tick_timer = 0.0
            for slime in entities.of(Slime):
                let dx = slime.pos.x - player_x
                let dy = slime.pos.y - player_y
                if dx * dx + dy * dy < radius * radius:
                    despawn slime
                    kills += 1
            for bat in entities.of(Bat):
                let dx = bat.pos.x - player_x
                let dy = bat.pos.y - player_y
                if dx * dx + dy * dy < radius * radius:
                    despawn bat
                    kills += 1
            for sk in entities.of(Skeleton):
                let dx = sk.pos.x - player_x
                let dy = sk.pos.y - player_y
                if dx * dx + dy * dy < radius * radius:
                    despawn sk
                    kills += 1
            # Aura ticks the boss for 6 dmg per pulse. With a
            # 0.5s default cadence the boss takes ~4-5s in the
            # aura to die from this weapon alone — rewards staying
            # in melee but doesn't trivialize.
            for boss in entities.of(Boss):
                let dx = boss.pos.x - player_x
                let dy = boss.pos.y - player_y
                if dx * dx + dy * dy < radius * radius:
                    boss.hp -= 6.0
                    if boss.hp <= 0.0:
                        despawn boss
                        kills += 1

    function render():
        # Skip while the level-up modal is open. Engine render order
        # is state-on-render first, then every entity's render(); the
        # modal's opaque black rect runs first and these strokes draw
        # on top of it, so without this gate the cyan ring leaks over
        # the upgrade picker.
        if in_levelup:
            return
        circle_outline(
            at: (player_x - camera_x, player_y - camera_y),
            radius: radius,
            thickness: 2.0,
            color: color.cyan,
        )


# ---------------------------------------------------------------
# Spark — the death-poof effect. Spawned from `on <Enemy>.death`
# hooks; expands then fades out across `lifetime`. Pure visual
# decoration: no collision, no game-state interaction. Decoupling
# the effect from the kill site (via the death hook) means every
# enemy class gets the effect for free.
# ---------------------------------------------------------------
entity Spark:
    var pos = (0.0, 0.0)
    var lifetime = 0.3
    var max_lifetime = 0.3

    function update(dt):
        if in_levelup:
            return
        lifetime -= dt
        if lifetime <= 0.0:
            despawn self

    function render():
        if in_levelup:
            return
        # Fades in size from full → 0 across lifetime, so the
        # effect reads as "puff outward then dissipate" without
        # an alpha-blending step the engine doesn't yet expose.
        let t = lifetime / max_lifetime
        let size = 28.0 * t
        rect(
            at: (
                pos.x - camera_x - size * 0.5,
                pos.y - camera_y - size * 0.5,
            ),
            size: (size, size),
            color: color.white,
        )


# ---------------------------------------------------------------
# XPGem — drops on slime death. Pulls toward the player within
# `magnetic_radius` and collects on overlap. The pickup-on-touch
# pattern is genre-canonical: the player is incentivised to weave
# into kill clusters rather than play purely defensively.
# ---------------------------------------------------------------
entity XPGem:
    var pos = (0.0, 0.0)
    var value = 1

    function update(dt):
        if in_levelup:
            return
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let d2 = dx * dx + dy * dy
        # Pickup at 16px overlap.
        if d2 < 16.0 * 16.0:
            xp += value
            despawn self
            return
        # Magnetic pull within `magnetic_radius`. Pull speed
        # ramps with proximity — gems near the player snap in,
        # distant ones drift slowly. The non-linear pull is what
        # makes XP collection feel responsive.
        if d2 < magnetic_radius * magnetic_radius:
            let d = math.sqrt(d2)
            let pull = 360.0
            pos = (
                pos.x + dx / d * pull * dt,
                pos.y + dy / d * pull * dt,
            )

    function render():
        if in_levelup:
            return
        # Bright blue diamond so it reads against cyan slimes,
        # yellow projectiles, and purple bats. 8×8 — small enough
        # not to crowd the screen at high kill counts.
        rect(
            at: (pos.x - camera_x - 4, pos.y - camera_y - 4),
            size: (8, 8),
            color: color.blue
        )


# Enemy death → XPGem drop. Phase 9 session 7b's class-event hook
# fires when an instance is despawned from anywhere:
# Projectile.update, weapon hits, restart cleanup. The restart
# path also clears the XPGem pool so cleanup-spawned gems don't
# pollute the next run.
#
# Skeletons drop 2 XP because they take longer to reach + dodge
# bolts to kill. Bats drop 1 (they're plentiful but each is a
# low-skill swat with a Blade or Aura sweep).
on Slime.death(s):
    spawn XPGem at s.pos
    spawn Spark at s.pos

on Bat.death(b):
    spawn XPGem at b.pos
    spawn Spark at b.pos

on Skeleton.death(sk):
    spawn XPGem at sk.pos
    # Bonus drop — second gem at the same spot for net +2 XP.
    spawn XPGem at sk.pos
    spawn Spark at sk.pos

on Boss.death(b):
    # Boss kill is a level-up moment in itself: 10 gems → instant
    # +10 XP, which guarantees at least one level-up at typical
    # XP curves. Players land in the upgrade modal as the reward
    # beat for the boss fight. Three sparks for emphasis.
    for i in 0..<10:
        spawn XPGem at b.pos
    spawn Spark at b.pos
    spawn Spark at b.pos
    spawn Spark at b.pos


scene SurviveBeta:
    var elapsed = 0.0
    # Wave system. `wave_index` rolls every 30s; pacing scales with
    # the index (more slimes per spawn burst, shorter cadence). The
    # display name in the HUD is `wave_index + 1` so the player sees
    # "Wave 1" on launch, not "Wave 0".
    var wave_index = 0
    var wave_timer = 0.0
    var spawn_interval = 1.5
    # Auto-attack pacing. v1 fires one bolt every 0.6s — sessions
    # 5 + 6 will let the player upgrade `attack_interval` (and
    # eventually `bolts_per_attack`, multiple weapons, etc.).
    var attack_timer = 0.0

    initial: playing

    state playing:
        # State-entry body: seeds an opening squad of slimes around
        # the arena perimeter. Session 3's wave spawner will keep
        # the pressure up; this is the "you walked into a hostile
        # arena" first-impression beat.
        spawn Slime at (random.int(200..2200), 100)
        spawn Slime at (random.int(200..2200), 1700)
        spawn Slime at (100, random.int(200..1600))
        spawn Slime at (2300, random.int(200..1600))
        spawn Slime at (random.int(200..2200), 100)
        spawn Slime at (random.int(200..2200), 1700)

        every 16ms:
            let dt = time.dt
            elapsed += dt
            weapon_time += dt
            if player_iframes > 0.0:
                player_iframes -= dt

            # ---- Wave pacing. Index rolls every 30s. Each new wave
            # tightens the spawn cadence by 0.15s (floor 0.4s) and
            # adds one slime to the per-burst count. Final pacing
            # at wave 8: 0.4s cadence, 9 slimes per burst — "you
            # are not going to live forever" feel. ----
            let next_wave = math.floor(elapsed / 30.0)
            if next_wave > wave_index:
                wave_index = next_wave
                spawn_interval = 1.5 - wave_index * 0.15
                if spawn_interval < 0.4:
                    spawn_interval = 0.4
                # Boss every 5 waves. Counter increments each wave
                # roll; on hitting 5, spawn one boss at the top of
                # the camera viewport and reset. First boss arrives
                # at wave 5 (150s), then waves 10, 15, 20…
                boss_wave_counter += 1
                if boss_wave_counter >= 5:
                    boss_wave_counter = 0
                    spawn Boss at (
                        camera_x + view_w * 0.5,
                        camera_y - 60.0,
                    )
                    # Boss-arrival kinesthetic.
                    fx.screen_shake(amount: 14.0, duration: 0.4)
                    fx.ground_shockwave(at: (player_x - camera_x, player_y - camera_y), radius: 120.0)

            # Spawn burst.
            wave_timer += dt
            if wave_timer >= spawn_interval:
                wave_timer = 0.0
                let burst_size = 1 + wave_index
                for i in 0..<burst_size:
                    # Pick a side of the camera viewport, drop the
                    # slime ~40px outside it. Clamp to the arena
                    # so a player hugging the wall doesn't see
                    # slimes spawn in negative space.
                    let edge = random.int(0..<4)
                    var sx = 0.0
                    var sy = 0.0
                    let margin = 40.0
                    if edge == 0:
                        sx = camera_x + random.int(0..640)
                        sy = camera_y - margin
                    elif edge == 1:
                        sx = camera_x + random.int(0..640)
                        sy = camera_y + view_h + margin
                    elif edge == 2:
                        sx = camera_x - margin
                        sy = camera_y + random.int(0..480)
                    else:
                        sx = camera_x + view_w + margin
                        sy = camera_y + random.int(0..480)
                    if sx < 0.0:
                        sx = 0.0
                    if sx > arena_w:
                        sx = arena_w
                    if sy < 0.0:
                        sy = 0.0
                    if sy > arena_h:
                        sy = arena_h
                    # Enemy roster grows by wave_index. Wave 1
                    # (index 0): slimes only. Wave 2+: bats join.
                    # Wave 4+: skeletons join. Index → display
                    # wave is +1 (the HUD shows "Wave 2" when
                    # wave_index = 1).
                    var pool_size = 1
                    if wave_index >= 1:
                        pool_size = 2
                    if wave_index >= 3:
                        pool_size = 3
                    let enemy = random.int(0..<pool_size)
                    if enemy == 0:
                        spawn Slime at (sx, sy)
                    elif enemy == 1:
                        spawn Bat at (sx, sy)
                    else:
                        spawn Skeleton at (sx, sy)

            # ---- Auto-attack. The bolt picks its own target on
            # spawn-frame (see Projectile.update); we just fire
            # at the cadence and let the projectile aim itself. ----
            attack_timer += dt
            if attack_timer >= attack_interval:
                attack_timer = 0.0
                spawn Projectile at (player_x, player_y)

            # ---- Movement (keyboard + gamepad). ----
            let speed = player_speed * dt
            var dx = 0.0
            var dy = 0.0
            if key_held(settings.get("keys.right")) or key_held(settings.get("keys.right_alt")):
                dx += 1.0
            if key_held(settings.get("keys.left")) or key_held(settings.get("keys.left_alt")):
                dx -= 1.0
            if key_held(settings.get("keys.up")) or key_held(settings.get("keys.up_alt")):
                dy -= 1.0
            if key_held(settings.get("keys.down")) or key_held(settings.get("keys.down_alt")):
                dy += 1.0
            if gamepad.connected:
                let lx = gamepad_axis.lx
                let ly = gamepad_axis.ly
                if lx > 0.2 or lx < -0.2:
                    dx += lx
                if ly > 0.2 or ly < -0.2:
                    dy -= ly
            if gamepad.dright: dx += 1.0
            if gamepad.dleft:  dx -= 1.0
            if gamepad.dup:    dy -= 1.0
            if gamepad.ddown:  dy += 1.0
            # Diagonal motion stays at unit length so a controller
            # pulled to the corner doesn't outrun straight motion.
            let mag2 = dx * dx + dy * dy
            if mag2 > 1.0:
                let mag = math.sqrt(mag2)
                dx = dx / mag
                dy = dy / mag
            player_x += dx * speed
            player_y += dy * speed

            # ---- Arena bounds. The player stops at the world edge. ----
            if player_x < 16.0:
                player_x = 16.0
            if player_x > arena_w - 16.0:
                player_x = arena_w - 16.0
            if player_y < 16.0:
                player_y = 16.0
            if player_y > arena_h - 16.0:
                player_y = arena_h - 16.0

            # Camera follow via camera2d.* — deadzone-follow with a
            # Survivors-class lerp. Bounds set at top level.
            camera2d.follow(target: (player_x, player_y), lerp: 0.15, deadzone: (60.0, 40.0))
            camera_x = camera.pos.x - view_w * 0.5
            camera_y = camera.pos.y - view_h * 0.5

            # Game-over transition. HP is replenished + slimes
            # cleared in the `game_over` -> `playing` restart hook
            # so leaving this branch terminal is fine. The best-
            # wave / best-time tracker takes a snapshot here so
            # the next-run delta in the overlay is honest.
            if player_hp <= 0.0:
                let display_wave = wave_index + 1
                if display_wave > best_wave:
                    best_wave = display_wave
                if elapsed > best_time:
                    best_time = elapsed
                -> game_over

            # ---- Pause trigger. Esc on keyboard or B on gamepad
            # opens the pause menu. We use the engine pause()
            # primitive (not just a flag) — every-clocks halt
            # cleanly, while on-render and the button widgets
            # stay responsive so the menu is interactive. ----
            if key_pressed("escape") or gamepad_press.b:
                pause(true)
                -> paused

            # ---- Level-up detection. XP threshold met → roll
            # three upgrade picks, raise the in_levelup flag (the
            # entities check it and freeze in place), and
            # transition to the modal state. ----
            if xp >= xp_to_next_level:
                xp -= xp_to_next_level
                level += 1
                # Threshold ramps so each level takes more XP than
                # the last. Linear-ish curve; session 8 can tune.
                xp_to_next_level = xp_to_next_level + 3 + level
                let i = random.int(0..<7)
                var j = i + 1
                if j >= 7:
                    j -= 7
                var k = i + 2
                if k >= 7:
                    k -= 7
                pick_a = i
                pick_b = j
                pick_c = k
                in_levelup = true
                -> level_up

        on render():
            # Background grid. 80px tiles, drawn in world space and
            # offset by the camera. The cheap-but-effective trick:
            # only draw grid lines within ±view of the camera so we
            # don't waste a few hundred draw calls per frame on
            # off-screen tiles.
            let tile = 80.0
            var gx = math.floor(camera_x / tile) * tile
            var gy = math.floor(camera_y / tile) * tile
            var x = gx
            while x < camera_x + view_w + tile:
                rect(
                    at: (x - camera_x, 0),
                    size: (1, view_h),
                    color: color.gray
                )
                x += tile
            var y = gy
            while y < camera_y + view_h + tile:
                rect(
                    at: (0, y - camera_y),
                    size: (view_w, 1),
                    color: color.gray
                )
                y += tile

            # Arena edge — drawn so the player can see the world boundary.
            rect(
                at: (-camera_x, -camera_y),
                size: (arena_w, 2),
                color: color.white
            )
            rect(
                at: (-camera_x, arena_h - camera_y - 2),
                size: (arena_w, 2),
                color: color.white
            )
            rect(
                at: (-camera_x, -camera_y),
                size: (2, arena_h),
                color: color.white
            )
            rect(
                at: (arena_w - camera_x - 2, -camera_y),
                size: (2, arena_h),
                color: color.white
            )

            # Player — drawn at viewport center (mostly; offset
            # near world edges where the camera is clamped). Briefly
            # tinted yellow during i-frames so the hit feedback is
            # visible without a particle system.
            var px_color = color.green
            if player_iframes > 0.0:
                px_color = color.yellow
            rect(
                at: (player_x - camera_x - 12, player_y - camera_y - 12),
                size: (24, 24),
                color: px_color
            )

            # Damage feedback flows through fx.* — see take_player_damage.

            # HUD.
            let elapsed_s = math.floor(elapsed)
            text("Time: {elapsed_s}s", at: (10, 20), size: 18, color: color.white)
            let display_wave = wave_index + 1
            text("Wave {display_wave}", at: (540, 20), size: 18, color: color.yellow)
            text("Lv {level}", at: (300, 20), size: 18, color: color.cyan)
            # HP bar: 200px wide, scaled to current_hp / max_hp.
            rect(at: (10, 50), size: (204, 16), color: color.gray)
            let hp_w = 200.0 * (player_hp / player_max_hp)
            rect(at: (12, 52), size: (hp_w, 12), color: color.red)
            let hp_display = math.floor(player_hp)
            let max_hp_display = math.floor(player_max_hp)
            text("HP {hp_display}/{max_hp_display}", at: (10, 70), size: 12, color: color.white)
            text("Kills: {kills}", at: (540, 44), size: 16, color: color.yellow)
            # XP bar: along the bottom edge, 600px wide, scaled to
            # current XP / requirement. Blue to match the gem
            # color so the link is visible.
            rect(at: (20, 460), size: (604, 12), color: color.gray)
            let xp_w = 600.0 * (xp / xp_to_next_level)
            rect(at: (22, 462), size: (xp_w, 8), color: color.blue)
            text(
                "XP {xp} / {xp_to_next_level}",
                at: (260, 444),
                size: 12,
                color: color.white
            )

    state paused:
        on render():
            # Dim background. `pause(true)` keeps render running
            # but halts every-clocks + entity ticks, so the world
            # is frozen behind the menu — no slimes creep, no
            # bolts fly while the player is mid-decision.
            rect(at: (0, 0), size: (view_w, view_h), color: color.black)
            text(
                "PAUSED",
                at: (260, 80),
                size: 36,
                color: color.yellow,
            )
            text(
                "Esc on the playing screen toggles. Click a button below.",
                at: (80, 130),
                size: 14,
                color: color.gray,
            )
            if button(at: (160, 180), size: (320, 50), label: "Resume"):
                pause(false)
                -> playing
            if button(at: (160, 250), size: (320, 50), label: "Save Bindings"):
                # Persists the current key bindings so a future
                # launch picks them up via the top-level
                # `settings.try_load(...)` call. Phase 10 surface;
                # the rebind UI itself lives in
                # examples/keybind_demo.twe.
                settings.save("examples/survive_beta/survive_beta.save")
            if button(at: (160, 320), size: (320, 50), label: "Quit Run"):
                # Force-end the run — the scene resumes (so the
                # game_over state's render fires) and HP is set
                # to 0 so the death-transition path is honest
                # (best_wave / best_time tracker fires).
                pause(false)
                let display_wave = wave_index + 1
                if display_wave > best_wave:
                    best_wave = display_wave
                if elapsed > best_time:
                    best_time = elapsed
                player_hp = 0.0
                -> game_over

    state level_up:
        on render():
            # Dim overlay across the whole viewport. `color.black`
            # is opaque in v0.4 — there's no per-rect alpha
            # widget — but the player only loses ~half a second
            # of game-state visibility for a level pick, which
            # is genre-canonical anyway.
            rect(at: (0, 0), size: (view_w, view_h), color: color.black)
            text(
                "LEVEL UP!  (Lv {level})",
                at: (180, 60),
                size: 28,
                color: color.yellow
            )
            text(
                "choose an upgrade",
                at: (220, 100),
                size: 16,
                color: color.gray
            )
            # Three upgrade buttons. button() returns truthy on
            # click; on commit we apply the upgrade, lower the
            # in_levelup gate (entities tick again), and
            # transition back to the playing state.
            if button(at: (160, 150), size: (320, 50), label: upgrade_name(pick_a)):
                apply_upgrade(pick_a)
                in_levelup = false
                -> playing
            if button(at: (160, 220), size: (320, 50), label: upgrade_name(pick_b)):
                apply_upgrade(pick_b)
                in_levelup = false
                -> playing
            if button(at: (160, 290), size: (320, 50), label: upgrade_name(pick_c)):
                apply_upgrade(pick_c)
                in_levelup = false
                -> playing

    state game_over:
        on render():
            # Dim the background so the run summary reads cleanly
            # over whatever in-flight enemies still tick out.
            rect(at: (0, 0), size: (view_w, view_h), color: color.black)
            text(
                "Game Over",
                at: (240, 80),
                size: 36,
                color: color.red,
            )
            let display_wave = wave_index + 1
            text(
                "Wave reached: {display_wave}",
                at: (220, 160),
                size: 18,
                color: color.white,
            )
            let elapsed_s = math.floor(elapsed)
            text(
                "Survived: {elapsed_s}s",
                at: (220, 190),
                size: 18,
                color: color.white,
            )
            text(
                "Kills: {kills}",
                at: (220, 220),
                size: 18,
                color: color.yellow,
            )
            text(
                "Level: {level}",
                at: (220, 250),
                size: 18,
                color: color.cyan,
            )
            text(
                "Best wave: {best_wave}   Best time: {math.floor(best_time)}s",
                at: (160, 310),
                size: 16,
                color: color.gray,
            )
            text(
                "Press R or Start to restart",
                at: (180, 380),
                size: 16,
                color: color.gray,
            )

        every 16ms:
            if key_pressed("r") or gamepad_press.start:
                # Reset to opening conditions. Slimes + projectiles
                # + gems from the prior run are still alive; clear
                # them so the player doesn't restart inside a swarm,
                # see ghost-bolts streak past, or accidentally pick
                # up XP from the previous run.
                for slime in entities.of(Slime):
                    despawn slime
                for bat in entities.of(Bat):
                    despawn bat
                for sk in entities.of(Skeleton):
                    despawn sk
                for boss in entities.of(Boss):
                    despawn boss
                for bolt in entities.of(SkeletonBolt):
                    despawn bolt
                for proj in entities.of(Projectile):
                    despawn proj
                for gem in entities.of(XPGem):
                    despawn gem
                for b in entities.of(Blade):
                    despawn b
                for a in entities.of(Aura):
                    despawn a
                for sp in entities.of(Spark):
                    despawn sp
                player_x = 1200.0
                player_y = 900.0
                player_hp = 100.0
                player_max_hp = 100.0
                player_speed = 220.0
                player_iframes = 0.0
                elapsed = 0.0
                kills = 0
                xp = 0
                xp_to_next_level = 5
                level = 1
                in_levelup = false
                magnetic_radius = 100.0
                attack_interval = 0.6
                weapon_time = 0.0
                wave_index = 0
                wave_timer = 0.0
                spawn_interval = 1.5
                attack_timer = 0.0
                boss_wave_counter = 0
                -> playing
