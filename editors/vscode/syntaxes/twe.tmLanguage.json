{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Twe",
  "scopeName": "source.twe",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "match": "#.*$", "name": "comment.line.number-sign.twe" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.twe",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.twe",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.twe",
              "match": "\\\\(\"|\\\\|n|r|t|b|f|0|\\{|\\}|u[0-9a-fA-F]{4})"
            },
            {
              "name": "meta.embedded.expression.twe",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#numbers" },
                { "include": "#keywords" },
                { "include": "#identifiers" },
                { "include": "#operators" }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.percent.twe",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?%"
        },
        {
          "name": "constant.numeric.quantity.twe",
          "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?(ms|min|h|kg|s)\\b"
        },
        {
          "name": "constant.numeric.float.twe",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.twe",
          "match": "\\b\\d[\\d_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.twe",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|spawn|despawn|extends|initial|state|every|on|render|update|key_press)\\b"
        },
        {
          "name": "keyword.declaration.twe",
          "match": "\\b(let|var|function|entity|item|modifier|inventory|scene|particles)\\b"
        },
        {
          "name": "keyword.operator.logical.twe",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "constant.language.twe",
          "match": "\\b(true|false|nil|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.twe",
          "match": "\\b(int|float|bool|string|tuple|list|range|nil)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.transition.twe",
          "match": "->"
        },
        {
          "name": "keyword.operator.range.twe",
          "match": "\\.\\.<?"
        },
        {
          "name": "keyword.operator.compound-assign.twe",
          "match": "(\\+=|-=|\\*=|/=)"
        },
        {
          "name": "keyword.operator.compare.twe",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.twe",
          "match": "[+\\-*/]"
        },
        {
          "name": "keyword.operator.assignment.twe",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.twe",
          "match": "\\b([a-zA-Z_][a-zA-Z_0-9]*)\\s*(?=\\()"
        },
        {
          "name": "variable.other.twe",
          "match": "\\b[a-zA-Z_][a-zA-Z_0-9]*\\b"
        }
      ]
    }
  }
}
