# @task: Lanternfall player module
# @inputs: Space leap, WASD move / steer, mouse aim, left click fire, E open / pick up, R reload, 1-3 / wheel switch, Shift roll, Q Starcall, hold F shield cell
# @expected: the keeper entity: riding the barge, leaping and gliding down, movement, cursor facing, rolling, looting, weapons, the Starcall ability and shield cells
# @category: 3d
# @difficulty: large
#
# Lanternfall — the keeper you play.
#
# Moves with WASD on a kinematic capsule (`physics.character`, so walls
# stop it), faces the cursor (`camera.ground_point`), and rolls with
# Shift. Carries four slots — melee, two guns, and Starcall — fires with
# the left button, reloads with R, and channels a shield cell by holding
# F. It animates on its own clock (`mesh_anim.*(self, ...)`), squashes
# when it lands a roll, and flashes when it is hurt.

import "tuning"
import "weapons"
import "combat"
import "loot"
import "world"

entity Player:
    var pos = vec3(0, 0, 0)
    var body = -1                 # its physics capsule
    var vel = vec3(0, 0, 0)       # ground velocity (m/s)
    var push = vec3(0, 0, 0)      # knockback, decaying
    var fall = 0.0                # vertical speed (m/s)
    var heading = 0.0             # where it faces (radians about +Y)
    var aim = vec3(0, 0, 1)       # the world point under the cursor
    var dodge_t = 0.0             # seconds left in a roll
    var dodge_cd = 0.0            # seconds until it may roll again
    var dodge_dir = vec3(0, 0, 1)
    var squash = 0.0              # 1 just after landing a roll, easing to 0
    var hurt = 0.0                # 1 just after a hit, easing to 0
    var kick = 0.0                # recoil, easing to 0 (the camera reads it)
    var hit_marker = 0.0          # 1 when a shot of yours lands, easing to 0
    var hit_from = vec3(0, 0, 0)  # where the last hit on you came from
    var hit_from_t = 0.0          # 1 just after, easing to 0
    var step_t = 0.0              # until the next puff of footstep dust
    # --- the actor contract (see combat.twe) ---
    var hp = 100.0
    var shield = 0.0
    var alive = true
    var iframes = 0.0
    var team = 1
    var name = "You"
    var kills = 0
    var died_at = 0.0
    var last_hit_by = nil
    var damage = 0.0              # dealt this round
    # --- the round ---
    var phase = "aboard"          # aboard the barge, glide down, ground
    var barge = nil
    var prompt = ""               # what E would do here ("" = nothing)
    # --- the loadout: slot 0 melee, 1-2 guns, 3 Starcall ---
    var guns = [0, -1, -1]        # weapon id per slot 0..2 (-1 empty)
    var rarity = [0, 0, 0]
    var mag = [0, 0, 0]           # rounds in each slot's magazine
    var reserve = 0               # spare rounds
    var slot = 0
    var fire_cd = 0.0
    var reload_t = 0.0            # seconds left reloading (0 = not)
    var star_cd = 0.0             # Starcall cooldown
    var cells = 0                 # shield cells carried
    var channel = 0.0             # seconds spent channelling a cell
    var control = true            # false while a menu or the drop owns it
    look:
        mesh: "assets/keeper.glb"
        facing: heading
        scale: vec3(1.0 + squash * 0.22, 1.0 - squash * 0.28, 1.0 + squash * 0.22)
        glow: (1.0, 0.85, 0.7) * hurt * 2.5

    function update(dt):
        squash = math.max(0.0, squash - dt * 4.0)
        if phase == "aboard":
            ride()
            return
        if phase == "glide":
            glide(dt)
            return
        if body < 0:
            body = physics.character(pos + vec3(0, tuning.BODY_HEIGHT / 2, 0), tuning.BODY_HEIGHT, tuning.BODY_RADIUS)
        hurt = math.max(0.0, hurt - dt * 5.0)
        kick = math.max(0.0, kick - dt * 9.0)
        hit_marker = math.max(0.0, hit_marker - dt * 7.0)
        hit_from_t = math.max(0.0, hit_from_t - dt * 1.2)
        dodge_cd = math.max(0.0, dodge_cd - dt)
        fire_cd = math.max(0.0, fire_cd - dt)
        star_cd = math.max(0.0, star_cd - dt)
        iframes = if dodge_t > 0.0: 1.0 else: 0.0
        if alive and control:
            steer(dt)
            arms(dt)
            channel_cell(dt)
            interact()
        else:
            vel = vel * math.max(0.0, 1.0 - tuning.FRICTION * dt / tuning.WALK_SPEED)
        move(dt)
        animate()
        # Dust at the feet while running.
        step_t -= dt
        if step_t <= 0.0 and math.length(vel) > 3.0:
            step_t = 0.26
            spawn combat.FootDust at pos + vec3(0, 0.05, 0)

    # The gun in hand (0: the wrench, or nothing).
    function held_gun():
        if slot > 0 and guns[slot] > 0:
            return guns[slot]
        return 0

    # WASD (or the left stick) to a ground velocity, the cursor to a
    # heading, Shift (or B) to a roll.
    function steer(dt):
        var mx = 0.0
        var mz = 0.0
        if key.a or key.left:
            mx -= 1.0
        if key.d or key.right:
            mx += 1.0
        if key.w or key.up:
            mz -= 1.0
        if key.s or key.down:
            mz += 1.0
        if math.abs(gamepad_axis.lx) > 0.2:
            mx += gamepad_axis.lx
        if math.abs(gamepad_axis.ly) > 0.2:
            mz -= gamepad_axis.ly
        let m = math.sqrt(mx * mx + mz * mz)
        if m > 1.0:
            mx = mx / m
            mz = mz / m
        let ground = camera.ground_point(mouse.pos, pos.y + tuning.AIM_HEIGHT)
        if ground != nil:
            aim = ground
        let ax = aim.x - pos.x
        let az = aim.z - pos.z
        if ax * ax + az * az > 0.04:
            heading = math.atan2(ax, az)
        if dodge_t > 0.0:
            dodge_t -= dt
            vel = dodge_dir * tuning.DODGE_SPEED
            if dodge_t <= 0.0:
                squash = 1.0
            return
        if (key_press.shift or gamepad_press.b) and dodge_cd <= 0.0:
            dodge_t = tuning.DODGE_TIME
            dodge_cd = tuning.DODGE_COOLDOWN
            channel = 0.0
            if m > 0.1:
                dodge_dir = math.normalize(vec3(mx, 0, mz))
            else:
                dodge_dir = vec3(math.sin(heading), 0, math.cos(heading))
            return
        var speed = tuning.WALK_SPEED
        if channel > 0.0:
            speed = tuning.WALK_SPEED * 0.35
        let want = vec3(mx, 0, mz) * speed
        let rate = if m > 0.05: tuning.ACCEL else: tuning.FRICTION
        let dv = want - vel
        let dl = math.length(dv)
        let step = rate * dt
        if dl <= step:
            vel = want
        else:
            vel = vel + dv * (step / dl)

    # Aboard: ride the barge until Space (or until it turns back).
    function ride():
        if barge == nil:
            phase = "glide"
            return
        pos = barge.pos + vec3(0, 1.4, 0)
        heading = math.atan2(barge.dir.x, barge.dir.z)
        mesh_anim.play(self, "idle", true)
        if (key_press.space or gamepad_press.a) or barge.time_left() <= 0.0:
            leap()

    function leap():
        phase = "glide"
        vel = barge.dir * barge.speed * 0.5
        pos = pos + vec3(0, -2.0, 0)

    # Gliding down: steer with WASD, drift to the ground, land.
    function glide(dt):
        var mx = 0.0
        var mz = 0.0
        if key.a or key.left:
            mx -= 1.0
        if key.d or key.right:
            mx += 1.0
        if key.w or key.up:
            mz -= 1.0
        if key.s or key.down:
            mz += 1.0
        let want = vec3(mx, 0, mz) * tuning.GLIDE_SPEED
        vel = vel + (want - vel) * math.min(1.0, dt * 2.5)
        let next = pos + vel * dt - vec3(0, tuning.GLIDE_FALL * dt, 0)
        if vel.x * vel.x + vel.z * vel.z > 0.5:
            heading = math.atan2(vel.x, vel.z)
        mesh_anim.play(self, "glide", true)
        let lim = tuning.ISLAND_HALF - 5.0
        pos = vec3(math.clamp(next.x, -lim, lim), next.y, math.clamp(next.z, -lim, lim))
        if pos.y <= 0.0:
            if world.clear_ground(pos.x, pos.z, 0.6):
                land()
            else:
                # Over a building: drift toward the middle until clear.
                let d = math.max(1.0, math.sqrt(pos.x * pos.x + pos.z * pos.z))
                pos = vec3(pos.x - pos.x / d * 4.0 * dt, 0.0, pos.z - pos.z / d * 4.0 * dt)

    function land():
        pos = vec3(pos.x, 0.0, pos.z)
        phase = "ground"
        vel = vel * 0.3
        squash = 1.0
        spawn combat.LandDust at pos
        combat.shake_near(pos, 3.0, 0.15)

    # What's within reach: E opens a chest or picks up a weapon; ammo and
    # cells are picked up by walking over them.
    function interact():
        prompt = ""
        let l = loot.nearest_loot(pos, 1.7)
        if l != nil:
            if l.kind == loot.AMMO:
                reserve += l.amount
                combat.popup(pos + vec3(0, 2.0, 0), "+{l.amount} ammo", (1.0, 0.85, 0.45), 14.0)
                loot.take(l)
                return
            if l.kind == loot.CELL and cells < 6:
                cells += 1
                combat.popup(pos + vec3(0, 2.0, 0), "+1 cell", (0.45, 0.75, 1.0), 14.0)
                loot.take(l)
                return
            if l.kind == loot.WEAPON:
                prompt = "E  take {weapons.RARITY_NAMES[l.rarity]} {weapons.name_of(l.gun)}"
                if key_press.e or gamepad_press.x:
                    pick_up(l)
                return
        let c = loot.nearest_chest(pos, 2.4)
        if c != nil:
            prompt = "E  open chest"
            if key_press.e or gamepad_press.x:
                loot.open_chest(c)

    # Into an empty gun slot, else in place of the gun in hand (dropping it).
    function pick_up(l):
        var s = -1
        if guns[1] < 0:
            s = 1
        elif guns[2] < 0:
            s = 2
        elif slot > 0:
            s = slot
        else:
            s = 1
        if guns[s] >= 0:
            loot.spill(pos, loot.WEAPON, guns[s], rarity[s], 0)
        guns.set(s, l.gun)
        rarity.set(s, l.rarity)
        mag.set(s, weapons.magazine_of(l.gun, l.rarity))
        slot = s
        reload_t = 0.0
        combat.popup(pos + vec3(0, 2.0, 0), weapons.name_of(l.gun), weapons.RARITY_COLORS[l.rarity], 15.0)
        loot.take(l)

    # Slots, firing, reloading, Starcall.
    function arms(dt):
        if key_pressed("1"):
            pick(0)
        if key_pressed("2"):
            pick(1)
        if key_pressed("3"):
            pick(2)
        if mouse.wheel > 0.0:
            pick(math.mod(slot + 2, 3))
        if mouse.wheel < 0.0:
            pick(math.mod(slot + 1, 3))
        if reload_t > 0.0:
            reload_t -= dt
            if reload_t <= 0.0:
                finish_reload()
        let id = guns[slot]
        if id < 0:
            return
        let need = weapons.magazine_of(id, rarity[slot])
        if (key_press.r or gamepad_press.x) and reload_t <= 0.0 and need > 0 and mag[slot] < need and reserve > 0:
            reload_t = weapons.reload_of(id)
        if (mouse_held.left or gamepad.rt) and fire_cd <= 0.0 and reload_t <= 0.0:
            if need == 0 or mag[slot] > 0:
                combat.fire(self, id, rarity[slot], muzzle(), heading, aim)
                fire_cd = weapons.interval_of(id)
                channel = 0.0
                if need > 0:
                    mag.set(slot, mag[slot] - 1)
                    kick = 1.0
                    fx.screen_shake(1.2, 0.05)
                    if weapons.kind_of(id) == weapons.HITSCAN:
                        spawn combat.Casings at muzzle()
                else:
                    mesh_anim.play(self, "melee", false)
            elif reserve > 0:
                reload_t = weapons.reload_of(id)
        if (key_press.q or gamepad_press.y) and star_cd <= 0.0:
            combat.starcall(self, aim)
            star_cd = tuning.STAR_COOLDOWN

    function pick(s):
        if guns[s] >= 0 and s != slot:
            slot = s
            reload_t = 0.0
            fire_cd = math.max(fire_cd, 0.2)

    function finish_reload():
        let id = guns[slot]
        let need = weapons.magazine_of(id, rarity[slot]) - mag[slot]
        let take = math.min(need, reserve)
        mag.set(slot, mag[slot] + take)
        reserve = reserve - take

    # Hold F (or LB), standing nearly still, to turn a cell into shield.
    function channel_cell(dt):
        if (key.f or gamepad.lb) and cells > 0 and shield < 100.0 and hurt <= 0.0:
            channel += dt
            if math.mod(math.floor(channel * 10), 3) == 0:
                spawn combat.HealMotes at pos + vec3(0, 0.3, 0)
            if channel >= tuning.CELL_TIME:
                shield = math.min(100.0, shield + tuning.CELL_SHIELD)
                cells = cells - 1
                channel = 0.0
                combat.popup(pos + vec3(0, 2.0, 0), "+{tuning.CELL_SHIELD} SHIELD", (0.45, 0.75, 1.0), 16.0)
        else:
            channel = 0.0

    # Slide the capsule along the ground and walls; fall under gravity.
    function move(dt):
        fall = fall - tuning.GRAVITY * dt
        push = push * math.max(0.0, 1.0 - dt * 8.0)
        let moved = physics.character_move(body, vel + push + vec3(0, fall, 0), dt)
        if moved.grounded:
            fall = -1.0
        let p = physics.position(body)
        pos = vec3(p.x, p.y - tuning.BODY_HEIGHT / 2, p.z)

    function animate():
        if not alive:
            mesh_anim.play(self, "death", false)
        elif dodge_t > 0.0:
            mesh_anim.play(self, "run", true)
        elif channel > 0.0:
            mesh_anim.play(self, "channel", true)
        elif mesh_anim.current(self).clip == "melee" and fire_cd > 0.15:
            mesh_anim.play(self, "melee", false)
        else:
            let speed = math.length(vel)
            if slot > 0:
                mesh_anim.blend_space(self, ["idle_armed", "run_armed"], [0.0, tuning.WALK_SPEED], speed)
            else:
                mesh_anim.blend_space(self, ["idle", "run"], [0.0, tuning.WALK_SPEED], speed)

    # Holding a gun (not the wrench)?
    function slot_is_gun():
        return slot > 0 and guns[slot] > 0

    # The point the keeper's hands are at, for muzzle flashes and shots.
    function muzzle():
        return pos + vec3(math.sin(heading) * 0.62, 0.95, math.cos(heading) * 0.62)
