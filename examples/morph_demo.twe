# @task: morph-target animation demo
# @inputs: none
# @expected: a quad whose +X edge rises and falls via a morph target
# @category: 3d
# @difficulty: trivial
#
# web3d-M9 session 2 — morph targets.
#
# Loads `examples/assets/morph_quad.glb` (generated by the
# `gen_morph_quad` test): a flat quad with one morph target that
# lifts its +X edge, driven by a built-in weights animation named
# "pulse" (0 -> 1 -> 0 over two seconds). Playing the clip and
# advancing it each frame morphs the geometry on the CPU — the
# vertex buffer is re-blended and re-uploaded only when the weight
# changes, so every pass (lit, shadow, AO) sees the morphed shape.
#
# Run with:
#   twec play3d examples/morph_demo.twe

let quad = "examples/assets/morph_quad.glb"
let cam_distance = 3.0
var orbit = 0.4

on update(dt):
    orbit = orbit + 0.4 * dt
    camera.eye = vec3(
        cam_distance * math.sin(orbit),
        2.0,
        cam_distance * math.cos(orbit),
    )
    camera.target = vec3(0, 0.3, 0)
    # Drive the morph: "pulse" is the glb's weights animation.
    mesh_anim.play(quad, "pulse", true)
    mesh_anim.advance(dt)

on render():
    # A reference cube so the morphing quad has scale context.
    cube(at: vec3(0, -0.5, 0), color: color.gray, size: 0.2)
    mesh(quad, at: vec3(0, 0.3, 0), color: color.cyan, size: 2.0)
