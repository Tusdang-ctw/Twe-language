/target
**/*.rs.bk
Cargo.lock.bak
**/*.snap.new
.idea/
.vscode/

# Phase 12: build artifacts produced by `twec build` (per-target
# .exe / .app / .AppDir + Steam Depot layout). Reproducible from
# source; not source.
examples/*/dist/

# Phase 11 crash dumps land at the repo root by default.
twec-crash-*.log

# Local stdout/stderr captures from running twec — repo-root by habit.
twec_out.log
twec_err.log

# Save-system artifacts written by running examples locally.
*.save

# Scratch scripts kept at the repo root for quick iteration.
practice.twe

# Claude Code's per-project conversation + memory state.
.claude/
