# v1.0.1 session 2 — tween.* deterministic easing primitives.
# Pure functions of `t`; replay-safe. The test asserts known-value
# outputs so the runner can snapshot the result and detect any
# regression in the curve math.

# ---- linear endpoints + midpoint.
print(tween.ease("linear", 0))
print(tween.ease("linear", 0.5))
print(tween.ease("linear", 1))

# ---- ease_out_cubic — Penner classic.
# 1 - (1-t)^3 at t=0.5 = 0.875.
print(tween.ease("ease_out_cubic", 0.5))

# ---- smoothstep === ease_in_out_quad.
# 0.5*0.5*(3 - 2*0.5) = 0.5.
print(tween.ease("smoothstep", 0.5))

# ---- clamping: t < 0 -> 0, t > 1 -> 1.
print(tween.ease("ease_in_cubic", -1))
print(tween.ease("ease_in_cubic", 2))

# ---- lerp.
print(tween.lerp(0, 100, 0.25))
print(tween.lerp(0, 100, 0.5))

# ---- lerp_eased: ease_in_quad(0.5) = 0.25, so lerp 0..100 = 25.
print(tween.lerp_eased(0, 100, 0.5, "ease_in_quad"))

# ---- bounce_value: peaks at t=0.5 at b, returns to a at endpoints.
print(tween.bounce(0, 100, 0))
print(tween.bounce(0, 100, 0.5))
print(tween.bounce(0, 100, 1))
# Quadratic envelope at t=0.25: 4*0.25*0.75 = 0.75 of the way up.
print(tween.bounce(0, 100, 0.25))

# ---- shake: deterministic. Endpoint decays to zero; same args = same value.
print(tween.shake(0, 1, 8))
let a = tween.shake(2, 0.3, 8)
let b = tween.shake(2, 0.3, 8)
print(a == b)

# ---- eases() lists all 14 supported curve names.
let names = tween.eases()
print(names.length)
print(names[0])

# ---- 60-tick lerp determinism: every iteration computes the same
# value twice and confirms equality. Catches any hidden state.
let runs = 0
let i = 0
while i < 60:
    let t = (i + 0.0) / 59.0
    if tween.lerp_eased(0, 1, t, "ease_out_cubic") == tween.lerp_eased(0, 1, t, "ease_out_cubic"):
        runs += 1
    i += 1
print(runs)
