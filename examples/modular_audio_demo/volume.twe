# Phase 13 session 11 — volume helper module.
#
# Small utility surface: clamp a [0..1] volume, step it by a delta
# with the same clamp, and read the current source-of-truth value
# back as a percentage for HUD overlays. Imported from
# `examples/modular_audio_demo/main.twe` as `volume`.

function clamp(v):
    if v < 0.0:
        return 0.0
    if v > 1.0:
        return 1.0
    return v

function step(current, delta):
    return clamp(current + delta)

function as_percent(v):
    return clamp(v) * 100.0
