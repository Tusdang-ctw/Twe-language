# `twec play examples/survive.twe`
#
# Phase-2 vertical slice. Move with arrow keys (or WASD). Monsters
# spawn from the screen edges every 800ms and drift toward you.
# Touch one and it's game over — press R to restart. The scene tracks
# elapsed time as your score; a kill counter updates as bullets hit.
# Space shoots an upward bullet; bullets despawn monsters on overlap
# via `entities.of(Monster)`.
#
# Exercises every Phase-2 language feature: scene + state machine,
# every-clocks, on render(), key_press events, dynamic entities via
# `spawn ... at ...`, per-entity update/render dispatch, lists,
# tuple arithmetic, random, string interpolation, hot reload, and
# entity queries (`entities.of(Class)`).
#
# Phase 10 session 11: keys are now driven by `settings`. Defaults
# are seeded with `settings.set_default(...)`; any persisted bindings
# from `examples/survive.save` overlay them. The rebind UI lives in
# the companion `examples/pause_menu_demo.twe` — drop a `survive.save`
# next to this script (or run pause_menu_demo and click Save) to
# customize the controls without editing the source.
#
# ~140 lines. The roadmap's <500-line budget for the Phase 2 game
# (Lua/GDScript reference: 800–1000) holds with room to spare.

settings.set_default("keys.right", "right")
settings.set_default("keys.right_alt", "d")
settings.set_default("keys.left", "left")
settings.set_default("keys.left_alt", "a")
settings.set_default("keys.up", "up")
settings.set_default("keys.up_alt", "w")
settings.set_default("keys.down", "down")
settings.set_default("keys.down_alt", "s")
settings.set_default("keys.fire", "space")
settings.set_default("keys.restart", "r")
settings.try_load("examples/survive.save")

var player_x = 320.0
var player_y = 240.0
var alive = true
var kills = 0
let hit_sound = sound.load("examples/assets/silence.wav")

scene Survive:
    var elapsed = 0.0
    var spawn_timer = 0.0
    var fire_timer = 0.0

    initial: playing

    state playing:
        every 16ms:
            let dt = time.dt
            elapsed += dt

            let speed = 200.0 * dt
            if key_held(settings.get("keys.right")) or key_held(settings.get("keys.right_alt")):
                player_x += speed
            if key_held(settings.get("keys.left")) or key_held(settings.get("keys.left_alt")):
                player_x -= speed
            if key_held(settings.get("keys.up")) or key_held(settings.get("keys.up_alt")):
                player_y -= speed
            if key_held(settings.get("keys.down")) or key_held(settings.get("keys.down_alt")):
                player_y += speed

            spawn_timer += dt
            if spawn_timer >= 0.8:
                spawn_timer = 0.0
                let edge = random.int(0..<4)
                if edge == 0:
                    spawn Monster at (random.int(0..640), 0)
                elif edge == 1:
                    spawn Monster at (random.int(0..640), 480)
                elif edge == 2:
                    spawn Monster at (0, random.int(0..480))
                else:
                    spawn Monster at (640, random.int(0..480))

            fire_timer += dt
            if key_held(settings.get("keys.fire")) and fire_timer >= 0.18:
                fire_timer = 0.0
                spawn Bullet at (player_x, player_y - 20.0)

            if not alive:
                -> game_over

        on render():
            rect(at: (player_x - 12, player_y - 12), size: (24, 24), color: color.green)
            text("Time: {elapsed}s", at: (10, 20), size: 18, color: color.white)
            text("Kills: {kills}", at: (10, 44), size: 18, color: color.yellow)

    state game_over:
        on render():
            text("Game Over", at: (260, 200), size: 36, color: color.red)
            text("Survived: {elapsed}s", at: (240, 250), size: 20, color: color.white)
            text("Kills: {kills}", at: (270, 280), size: 20, color: color.yellow)
            text("Press R to restart", at: (220, 320), size: 16, color: color.gray)

        every 16ms:
            if key_pressed(settings.get("keys.restart")):
                elapsed = 0.0
                spawn_timer = 0.0
                fire_timer = 0.0
                alive = true
                kills = 0
                player_x = 320.0
                player_y = 240.0
                -> playing


entity Monster:
    var pos = (0.0, 0.0)
    var speed = 80.0
    var hp = 1

    function update(dt):
        let dx = player_x - pos.x
        let dy = player_y - pos.y
        let mag2 = dx * dx + dy * dy
        if mag2 < 18.0 * 18.0:
            alive = false
            despawn self
            return
        if mag2 < 1.0:
            return
        let mag = math.sqrt(mag2)
        pos = (pos.x + dx / mag * speed * dt, pos.y + dy / mag * speed * dt)

    function render():
        rect(at: (pos.x - 8, pos.y - 8), size: (16, 16), color: color.red)


entity Bullet:
    var pos = (0.0, 0.0)
    var vy = -360.0

    function update(dt):
        pos = (pos.x, pos.y + vy * dt)
        if pos.y < -10.0:
            despawn self
            return
        for monster in entities.of(Monster):
            let dx = monster.pos.x - pos.x
            let dy = monster.pos.y - pos.y
            if dx * dx + dy * dy < 14.0 * 14.0:
                despawn monster
                despawn self
                kills += 1
                sound.play(hit_sound)
                return

    function render():
        rect(at: (pos.x - 2, pos.y - 6), size: (4, 12), color: color.yellow)
