# @task: GPU particles in 3D — a spark fountain bouncing off blocks
# @inputs: space
# @expected: bursts of sparks arc up, fall, and bounce on the floor and blocks
# @category: 3d
# @difficulty: small
#
# `twec play3d examples/particles_3d.twe`, or build it for the browser
# with `twec build --target web examples/particles_3d.twe`.
#
# web3d-M7: in 3D, a `particles` block whose bodies the GPU can run is
# compiled to a compute shader and simulated there (a million at
# once is fine); `collide: true` bounces them off whatever the camera
# sees. Space fires a big burst. Blocks the GPU can't run stay on the
# CPU and draw the same way.

var t = 0.0
var next_burst = 0.0

particles Sparks:
    count: 4000
    lifetime: 3.0
    spread: 3.0
    collide: true

    on_spawn(p):
        let a = random.float() * 2.0 * math.pi
        let r = random.float() * spread
        p.velocity = (math.cos(a) * r, 6.0 + random.float() * 3.0, math.sin(a) * r)
        p.color = (1.0, 0.55 + random.float() * 0.3, 0.15, 1.0)
        p.size = 0.03 + random.float() * 0.03

    on_update(p, dt):
        p.velocity -= (0.0, 9.8, 0.0) * dt
        p.pos += p.velocity * dt
        # Cool from yellow to deep red, then fade.
        p.color = (1.0, 0.7 * (1.0 - p.age_ratio), 0.15 * (1.0 - p.age_ratio), 1.0 - p.age_ratio * p.age_ratio)

particles Embers:
    count: 60000
    lifetime: 6.0

    on_spawn(p):
        p.pos = (random.float() * 16.0 - 8.0, random.float() * 0.5, random.float() * 16.0 - 8.0)
        p.velocity = (0.0, 0.3 + random.float() * 0.6, 0.0)
        p.color = (1.0, 0.35, 0.1, 0.5)
        p.size = 0.02

    on_update(p, dt):
        let swirl = noise((p.pos.x * 0.4 + p.age, p.pos.z * 0.4))
        p.pos += (swirl, p.velocity.y, math.cos(p.age * 2.0) * 0.2) * dt
        p.color = (1.0, 0.35, 0.1, 0.5 * (1.0 - p.age_ratio))

postfx.bloom(0.6)

spawn Embers at vec3(0, 0, 0)

on update(dt):
    t += dt
    if t >= next_burst or key_pressed("space"):
        let x = math.sin(t * 0.7) * 3.0
        spawn Sparks at vec3(x, 0.2, math.cos(t * 0.5) * 2.0)
        next_burst = t + 0.35
    if math.mod(t, 6.0) < dt:
        spawn Embers at vec3(0, 0, 0)
    camera.eye = vec3(math.sin(t * 0.15) * 14.0, 8.0, math.cos(t * 0.15) * 14.0)
    camera.target = vec3(0, 1, 0)

on render():
    cube(at: vec3(0, -50, 0), size: 100, color: (0.25, 0.25, 0.28, 1))
    for i in 0..<8:
        let a = i * 0.785
        cube(at: vec3(math.cos(a) * 5.0, 0.5, math.sin(a) * 5.0), size: 1, color: (0.5, 0.52, 0.6, 1))
